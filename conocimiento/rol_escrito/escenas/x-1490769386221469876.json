      "texto_sha256": "9d8a5c267e3522c8388fbb129f0d3788935165979e4a76178f4020b320942130",
      "adjuntos": []
    },
    {
      "id": "1491709548078170182",
      "fecha_utc": "2026-04-09T08:01:10.885000+00:00",
      "fecha_local": "2026-04-09",
      "editado_utc": null,
      "texto": "🔴Fin de la escena🔴",
      "mensaje_sha256": "fb1c79adaa494ee53be8f43d7c629508611ce6dea53fcb6e01ee9762e30bb406",
      "tipo_discord": 0,
