      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1465410265544921190/1484242175825940530",
      "texto_sha256": "6b400ae8d04623a0730d3ce9874f43dbe93cf2188d1a0c1a1bc5a91b2b47a391",
