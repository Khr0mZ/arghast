      "fecha_utc": "2026-03-21T20:59:46.839000+00:00",
      "fecha_local": "2026-03-21",
      "editado_utc": null,
      "texto": "Ione: mientras no muerda yo **Va tambaleandose hasta dentro del barco** Shhhh vayamos en silencio q estos estan durmiendooooo",
      "mensaje_sha256": "525073c4356912f5bda58e0cbcd65510c61b92e2946954ec89130c5b60c1dcff",
      "tipo_discord": 19,
      "referencia": "1485009957224186020",
