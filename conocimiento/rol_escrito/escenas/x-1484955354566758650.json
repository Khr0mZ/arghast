      "fecha_local": "2026-03-21",
      "editado_utc": null,
      "texto": "Ione: **Va entrando al barco, se intenta dentro y acaba metiendo la pata en un cubo y empezando a rodar escaleras abajo**",
      "mensaje_sha256": "fa34595bc5ab4c8c821c51b5d62cda73bf3cf94239aece4c42a6b3fd4c8b366d",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1465410265544921190/1485025668478668911",
