      "texto_sha256": "e1e1ac4887d1699f85bba8a961b24a65cf9a67ddf2088dbdb75b019049cbef2b",
      "adjuntos": []
    },
    {
      "id": "1481344784231825408",
      "fecha_utc": "2026-03-11T17:35:18.616000+00:00",
      "fecha_local": "2026-03-11",
      "editado_utc": null,
      "texto": "Mugre: Yo? **Pregunta el pobre cocinero que tiene los bracitos mas escuálidos de todo Shiaru** Pero Capitana... no seria mejor que lo hiciera Babs? Au!!! **La mesa se mueve un poco ya que Babs le ha dado una patada al pobre Mugre**",
      "mensaje_sha256": "1a57a90b84f07cfac513fbc9b1bc4f8f9a505266ecb2372a752f7f471c41afa1",
      "tipo_discord": 19,
      "referencia": "1481343940748640276",
      "url_discord": "https://discord.com/channels/946724148628041748/1465411590789795962/1481344784231825408",
      "texto_sha256": "e41d723db5fd6cc898d73e745706d86f35d98c8644f76d9eb706a8ef6eb2b91d",
      "adjuntos": []
    },
    {
      "id": "1481344931036401734",
      "fecha_utc": "2026-03-11T17:35:53.617000+00:00",
      "fecha_local": "2026-03-11",
      "editado_utc": null,
      "texto": "Ione: solo es para que me pases la herramientas, vamos sera divertido",
