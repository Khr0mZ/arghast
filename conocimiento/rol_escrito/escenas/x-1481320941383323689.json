    },
    {
      "id": "1481345576644903052",
      "fecha_utc": "2026-03-11T17:38:27.542000+00:00",
      "fecha_local": "2026-03-11",
      "editado_utc": null,
      "texto": "Aerendriel:\n\n**Me acerco a la mesa lentamente**\n\nIone! Déjame que te ayude yo.",
