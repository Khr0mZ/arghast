      "texto_sha256": "18a3def2e66381b95c2b907613b67af73b82534a522e704de9a95781301e4015",
      "adjuntos": []
    },
    {
      "id": "1481346347771887706",
      "fecha_utc": "2026-03-11T17:41:31.393000+00:00",
      "fecha_local": "2026-03-11",
      "editado_utc": null,
      "texto": "Babs: Tu zabe areglá un barco? **Te mira el hombre-perro** Pero zi tiene pinta de elfo que no a trasbajao en zu bida...",
      "mensaje_sha256": "0bbae4a7c5da4f9972f05ab014bc1dfdec8b7d45727c6badfa6ec0accf3df2b1",
      "tipo_discord": 19,
