      "adjuntos": []
    },
    {
      "id": "1481345406980853921",
      "fecha_utc": "2026-03-11T17:37:47.091000+00:00",
      "fecha_local": "2026-03-11",
      "editado_utc": null,
      "texto": "Mugre: Como quiera capitana... **Dice a regañadientes pero sin negarse, ya que sino, puede recibir un IoneCena**",
      "mensaje_sha256": "6c541dc8b000ab1721f22b10281eae80b75477567564e1cc9307293bba140cf8",
