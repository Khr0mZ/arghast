      "adjuntos": []
    },
    {
      "id": "1481346112794398760",
      "fecha_utc": "2026-03-11T17:40:35.370000+00:00",
      "fecha_local": "2026-03-11",
      "editado_utc": null,
      "texto": "Ione: a genial, pues mañana pasate por mi barco y nos ponemos los dos a trabajar duro **Saca musculo de su brazo**",
      "mensaje_sha256": "e200afd3a19633345ea32be95676bb8753e8940080bec2f27c5c1e1e5c9ec32d",
      "tipo_discord": 19,
      "referencia": "1481345576644903052",
