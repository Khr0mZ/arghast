    },
    {
      "id": "1496508549797253301",
      "fecha_utc": "2026-04-22T13:50:42.056000+00:00",
      "fecha_local": "2026-04-22",
      "editado_utc": null,
      "texto": "Eldrath: *Lo que voy a encontrar antes a este paso es una sordera* **Se tapa los oidos y sigue caminando por el pueblo buscando a ese perro**",
      "mensaje_sha256": "91458340adc9788ed8b07aef2c9af0ac73c5e26b1190a1ba2ecae04ff9d95256",
      "tipo_discord": 19,
      "referencia": "1496508277926793366",
