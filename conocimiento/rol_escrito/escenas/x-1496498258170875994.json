    },
    {
      "id": "1496508045818204352",
      "fecha_utc": "2026-04-22T13:48:41.898000+00:00",
      "fecha_local": "2026-04-22",
      "editado_utc": null,
      "texto": "Eldrath: ¡Como la gente normal! ¡Buscandolo con la mirada!",
      "mensaje_sha256": "49bb6733adb953b18e471219c4b07b5c7e306ba6e63093d2c64467d11208bb6c",
