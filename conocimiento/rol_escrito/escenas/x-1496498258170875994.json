    {
      "id": "1496508277926793366",
      "fecha_utc": "2026-04-22T13:49:37.237000+00:00",
      "fecha_local": "2026-04-22",
      "editado_utc": null,
      "texto": "Tryel: Pffff... Eso es de pringados **Hace una pedorreta** A ver si lo encuentras tu antes con \"la mirada\" que yo... PERRITOOOOOOOOOO!!!",
      "mensaje_sha256": "3ad3bb0d9042cdfa411ab27c0a1c4af674a2d7a4f28a25702f84053fee34b781",
      "tipo_discord": 19,
      "referencia": "1496508045818204352",
