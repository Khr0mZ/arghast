      "texto_sha256": "f9eb6d7fb2308487c909e5f3c75ce65fdbc9cca77c31101f2ec377d2cda627de",
      "adjuntos": []
    },
    {
      "id": "1496519544368267274",
      "fecha_utc": "2026-04-22T14:34:23.366000+00:00",
      "fecha_local": "2026-04-22",
