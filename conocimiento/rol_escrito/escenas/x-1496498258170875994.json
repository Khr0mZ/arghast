      "adjuntos": []
    },
    {
      "id": "1496507900925837334",
      "fecha_utc": "2026-04-22T13:48:07.353000+00:00",
      "fecha_local": "2026-04-22",
      "editado_utc": null,
      "texto": "Tryel: PERRITOOOOOOOooo!! **Te mira extrañada** ¿Y como quieres que lo busque? Tendré que gritar para que me oiga...",
      "mensaje_sha256": "c9860c6d255bdb732af2b3c4c763889f05d14b3f2d45b4e2b88acae1a8972986",
      "tipo_discord": 19,
