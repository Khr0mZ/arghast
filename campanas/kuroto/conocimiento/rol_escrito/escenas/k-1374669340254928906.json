      "adjuntos": []
    },
    {
      "id": "1374673475582693376",
      "fecha_utc": "2025-05-21T09:01:36.777000+00:00",
      "fecha_local": "2025-05-21",
      "editado_utc": null,
      "texto": "jhin: **algo sorprendido por esa contestacion tan tajante de parte de kalista** que vas a hacer esta cueva esta inestable y si haces alguna locura las posibilidades de rescatarlo son minimas",
      "mensaje_sha256": "c896ecce2aafe86ddade30d7e038fc2841fc9f92811e856a7f8fe301e6e3b40a",
      "tipo_discord": 19,
      "referencia": "1374673107251363861",
