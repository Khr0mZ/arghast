      "id": "1425128641377075324",
      "fecha_utc": "2025-10-07T14:32:25.714000+00:00",
      "fecha_local": "2025-10-07",
      "editado_utc": null,
      "texto": "Banzo: **levanta los hombros ** ni idea ...",
      "mensaje_sha256": "67325437b9ce5a253b08b5936879d2e01b70531514faaae27135bc31caf1681f",
      "tipo_discord": 19,
      "referencia": "1425127708429652139",
