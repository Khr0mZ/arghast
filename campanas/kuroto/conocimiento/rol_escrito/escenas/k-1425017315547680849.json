    {
      "id": "1425128989948776488",
      "fecha_utc": "2025-10-07T14:33:48.820000+00:00",
      "fecha_local": "2025-10-07",
      "editado_utc": null,
      "texto": "Y arwen vigilando el bosque en el Norte.. tambien necesita apoyo ..no llegamos",
      "mensaje_sha256": "b98853f6ca15407a2b87a80ea7821c0184e4ca565ee845304a761b9d933cb9c1",
      "tipo_discord": 0,
      "referencia": null,
