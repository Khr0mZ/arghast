    },
    {
      "id": "1384566349610749982",
      "fecha_utc": "2025-06-17T16:12:21.746000+00:00",
      "fecha_local": "2025-06-17",
      "editado_utc": null,
      "texto": "Seraphina:\nPrimero lo primero, vayamos a comprar lo que tú necesitas y ya después vemos lo demás, de acuerdo?\n\n**Recargaba mi cabeza en su brazo y le hacia caricias en la mejilla con mi oreja**",
      "mensaje_sha256": "88939e3db936ae205b9da9ebc6d148165d3196340398028c84e7c27ad013bddb",
      "tipo_discord": 19,
      "referencia": "1384566050087112836",
