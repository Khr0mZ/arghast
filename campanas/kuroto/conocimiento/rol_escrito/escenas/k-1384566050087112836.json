      "texto_sha256": "01aa351ded755540e1609cd6468dde67e5879273b87e72c1307844c882be77df",
      "adjuntos": []
    },
    {
      "id": "1384566818282274858",
      "fecha_utc": "2025-06-17T16:14:13.486000+00:00",
      "fecha_local": "2025-06-17",
      "editado_utc": null,
      "texto": "guxi: **le ofrece el brazo para agarrarse y que vayan juntos y le responde con un beso** bueno necesito papel y tinta vamos a ello",
      "mensaje_sha256": "d8fbce828f9196441c1ec95c94b29fcab98758790cdb09e59a36e8eced6a17ac",
      "tipo_discord": 19,
      "referencia": "1384566349610749982",
