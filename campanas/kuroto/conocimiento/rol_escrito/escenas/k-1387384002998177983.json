    },
    {
      "id": "1387414087096336404",
      "fecha_utc": "2025-06-25T12:48:15.271000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "<@214405113677217793>",
      "mensaje_sha256": "a8d8290d34af753e9d0ca4d5f4815cdc2ac16210caefdcf57000bdd3aed7d192",
