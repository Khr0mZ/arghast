    {
      "id": "1387417759012356117",
      "fecha_utc": "2025-06-25T13:02:50.724000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "Banzo: que sea que ?? Estrés? Que decís...\n\nNo le puedes hacer algo a ver si esta maldita o algo así?",
      "mensaje_sha256": "726ac05aea7b15aed4d081a072d369efe577bbb2348eddfce76cd1cb837dea6f",
      "tipo_discord": 19,
