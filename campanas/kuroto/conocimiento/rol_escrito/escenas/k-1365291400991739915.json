      "texto_sha256": "0e5157f91f340b3647c7e38eb249afb392d145a9454d9610407b681bc1f94d23",
      "adjuntos": []
    },
    {
      "id": "1365323241878585475",
      "fecha_utc": "2025-04-25T13:47:07.343000+00:00",
      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Guxi: **con una leve reaccion de sopresa en su rostro** al fin te pongo cara me han hablado mucho de ti aunque nunca hemos coincidido **al ver el cafe frio se acerca a la pequeña cocina para calentar la cafetera** perdoname no sabia mas de ti que tus hazañas ni siquiera sabia nada de como luces",
      "mensaje_sha256": "fb69bcb4d3118974357ca9f9939b6266105bb2091fe263ea704e1a0b2b683187",
      "tipo_discord": 19,
      "referencia": "1365322403835805756",
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1365323241878585475",
      "texto_sha256": "4c5f0022a906a8513520af522725773aafca4a4036d637e765e1f10b98dd63ab",
      "adjuntos": []
    },
    {
