      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Guxi: **hace una mueca de resignacion** ¿tanto se nota?",
      "mensaje_sha256": "c49e1a9a493a17de56db163453804cf06f995d91cf368e6928629f4df1be82d3",
      "tipo_discord": 19,
      "referencia": "1365325388330569729",
