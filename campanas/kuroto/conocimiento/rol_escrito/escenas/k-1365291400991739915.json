      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Kalista: **Se sonrie** ¿Hazañas? No he hecho mucho ¿Que dicen de mi?",
      "mensaje_sha256": "6dd56aaa78b525c11e3adc46413ecc29dfb327e5a46d40e552d9085117bc0bb9",
      "tipo_discord": 19,
      "referencia": "1365323241878585475",
