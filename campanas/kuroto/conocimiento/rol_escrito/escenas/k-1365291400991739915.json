      "adjuntos": []
    },
    {
      "id": "1365325164719640617",
      "fecha_utc": "2025-04-25T13:54:45.784000+00:00",
      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Guxi: **con una sonrisa cansada** todo el mundo hace lo que puede incluso mas pero parece que no es suficiente **mientras deriva un poco la mirada a la mesa llena de papeles y con la cafetera se acerca lentamente hacia la mesa** aqui tienes tu cafe",
      "mensaje_sha256": "b6b9a89d5cb5dc57beecc22ce9e22fca14881ba247d35872a8479c037890cfe5",
      "tipo_discord": 0,
      "referencia": null,
