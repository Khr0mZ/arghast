      "adjuntos": []
    },
    {
      "id": "1365324028700786781",
      "fecha_utc": "2025-04-25T13:50:14.936000+00:00",
      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Guxi: parece que te has ganado el favor de muchos incluido el de Rua y eso que he escuchado que no eres de kuroto es como minimo ... impresionante",
