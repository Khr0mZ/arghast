      "adjuntos": []
    },
    {
      "id": "1365324551344623667",
      "fecha_utc": "2025-04-25T13:52:19.544000+00:00",
      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Kalista: **Ves como se recoge el pelo tras las orejas en un gesto algo timido** S-solo trato de hacer bien mi deber...quiero arreglar las relaciones con mi reino...Trato de ser util y ayudar en lo que puedo",
      "mensaje_sha256": "750e807caeb27902d3744e7364e74e35548b9ada3c0b334ef4c3193fc088d6bd",
      "tipo_discord": 19,
      "referencia": "1365324028700786781",
