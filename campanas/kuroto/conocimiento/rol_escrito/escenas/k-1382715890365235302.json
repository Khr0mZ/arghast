      "adjuntos": []
    },
    {
      "id": "1382721423285420042",
      "fecha_utc": "2025-06-12T14:01:17.033000+00:00",
      "fecha_local": "2025-06-12",
      "editado_utc": null,
      "texto": "Kurobane:\n\n**Se gira lentamente a escasos metros de la puerta**\n\nSi, señorita Kalista, soy yo.\n\n**Dice serio pero igual de vacío que su mirada**",
      "mensaje_sha256": "e727767b7bb8aa1624fd3715ff92a211ab0f4f88c6b19ec548fcf22dd9b5a17c",
      "tipo_discord": 19,
      "referencia": "1382720826712785037",
