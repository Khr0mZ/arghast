    },
    {
      "id": "1390299181968658545",
      "fecha_utc": "2025-07-03T11:52:35.491000+00:00",
      "fecha_local": "2025-07-03",
      "editado_utc": null,
      "texto": "**El mapa que ves es el mismo de siempre, ves varios puntos marcados con defensas y escuadrones enviados allí para defenderlos. Muchos puntos de las montañas están marcados con unos triángulos, estos representan torres de vigilancia para observar la Puerta Negra y avisar de movimientos de los demonios**",
      "mensaje_sha256": "51bd3597cb081f81fd8608becfe0727eb701dcbc516dab409aea1b57095d0d86",
      "tipo_discord": 19,
      "referencia": "1390297133051019264",
