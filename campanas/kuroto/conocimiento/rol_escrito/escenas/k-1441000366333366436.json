      "fecha_local": "2025-11-20",
      "editado_utc": null,
      "texto": "Arwen: si Arwen volvio s estar fuerte gracias a sus amigos",
      "mensaje_sha256": "34876fdc6913d46794488a4f158908050c06b7edfff28c8d12d395cc58834cbc",
      "tipo_discord": 19,
      "referencia": "1441036195478900766",
