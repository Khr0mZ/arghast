      "editado_utc": "2025-11-20T12:07:44.115000+00:00",
      "texto": "Arwen: **Ladea la cabeza en un gesto adorable, como un cachorro q no entiende**",
      "mensaje_sha256": "95edb80da9605d40546aff26224e9ce9a9420ce4f0e072d9a0a0c84302952649",
      "tipo_discord": 19,
      "referencia": "1441037050513195154",
