    },
    {
      "id": "1405175023530020975",
      "fecha_utc": "2025-08-13T13:03:52.499000+00:00",
      "fecha_local": "2025-08-13",
      "editado_utc": null,
      "texto": "Jelbreg: Que pasa Mai? Donde esta Kalista?",
      "mensaje_sha256": "884ddc0e15b90c2bee2f9634c99548fc3c53e2ef839878a1f49661355c1e5f0f",
      "tipo_discord": 19,
      "referencia": "1405174468040593501",
      "url_discord": "https://discord.com/channels/946724148628041748/1387915737502580886/1405175023530020975",
      "texto_sha256": "17b5649c6061235db35786118a19b2b0091063c63ab36c99197a9cd51e8b7606",
      "adjuntos": []
    },
    {
      "id": "1405175632991748117",
      "fecha_utc": "2025-08-13T13:06:17.806000+00:00",
      "fecha_local": "2025-08-13",
      "editado_utc": null,
      "texto": "Mai: en su habitacion mi señor, ha pedido expresamente no ver a nadie y que la llevaramos el trabajo ahi...No se ve muy bien...",
      "mensaje_sha256": "ac17b25ad53fb2ed959d8a897b713d07eb2b300e227b7a67bb177d28e0e67d2f",
      "tipo_discord": 19,
      "referencia": "1405175023530020975",
      "url_discord": "https://discord.com/channels/946724148628041748/1387915737502580886/1405175632991748117",
      "texto_sha256": "c1eac402d0ef87da9f045789d28ab15bf2661ce1b561518e0debdb859e416a2a",
      "adjuntos": []
    },
    {
      "id": "1405175958654423061",
      "fecha_utc": "2025-08-13T13:07:35.450000+00:00",
      "fecha_local": "2025-08-13",
      "editado_utc": null,
      "texto": "Jelbreg: **Se preocupa y mira a las escaleras. Con un susurro dice** Es culpa mia...",
      "mensaje_sha256": "4f502d4362fa9fb0b27dc13a96f8cf91edafb6cd6df8c2e3186c0a38e1c0f0b5",
      "tipo_discord": 19,
      "referencia": "1405175632991748117",
