      "afirmacion": "Chanecuxtli araña la cara de Banzo al perseguir una mosca.",
      "tipo": "accion"
    },
    {
      "mensaje_id": "1405969739154460793",
      "afirmacion": "Jelbreg pide que Banzo visite palacio al día siguiente.",
      "tipo": "dialogo"
    },
    {
      "mensaje_id": "1405970333185474640",
