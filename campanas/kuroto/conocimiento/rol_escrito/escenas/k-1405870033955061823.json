      "tipo": "dialogo"
    },
    {
      "mensaje_id": "1405950095035338772",
      "afirmacion": "Guxi confirma que oye a Banzo mediante el nuevo dispositivo.",
      "tipo": "dialogo"
    },
    {
      "mensaje_id": "1405962101503299705",
      "afirmacion": "Banzo confirma que también escucha a Guxi y relaciona a Danifae con varios problemas.",
      "tipo": "dialogo"
    },
    {
      "mensaje_id": "1405964177096572950",
      "afirmacion": "Banzo muestra la caracola a Chanecuxtli e inicia la llamada a Jelbreg.",
      "tipo": "accion"
    },
    {
      "mensaje_id": "1405967418798379090",
      "afirmacion": "Banzo considera hablar con Danifae, retenida en palacio.",
