      "fecha_utc": "2025-04-26T21:15:58.513000+00:00",
      "fecha_local": "2025-04-26",
      "editado_utc": null,
      "texto": "jhin: **le dedica una sonrisa a las dos antes de ponerse la mascara y irse**",
