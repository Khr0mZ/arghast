      "fecha_utc": "2025-04-26T21:15:15.161000+00:00",
      "fecha_local": "2025-04-26",
      "editado_utc": null,
      "texto": "Arwen: **Se despide con el piñito cerrandolo y abriendolo** Adios Adios Jin",
