      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362468595212488835/1365798587258372136",
      "texto_sha256": "b32a891b2152373fb63e7343e6bc0bfb13a7d21e3d9821b72f257b984ca094c7",
      "adjuntos": []
    },
    {
      "id": "1365799221785002005",
      "fecha_utc": "2025-04-26T21:18:29.796000+00:00",
      "fecha_local": "2025-04-26",
      "editado_utc": null,
      "texto": "jhin: **sale de la taberna a preguntarle a alguno de los samurais de fuera si sabe algo del temblor** <@214405113677217793>",
      "mensaje_sha256": "f4ba998c35dfa67ca68f1de8f6c651aaacefa4881dbb5a00216d0ce46402f320",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362468595212488835/1365799221785002005",
      "texto_sha256": "ee9289fcc044a2d507763823f1266deb4966e4f6b43ca8a7dbde03ee44c256ba",
      "adjuntos": []
    },
    {
