      "fecha_utc": "2025-04-26T20:17:45.756000+00:00",
      "fecha_local": "2025-04-26",
      "editado_utc": "2025-04-26T20:19:36.996000+00:00",
      "texto": "Arwen: valeeeeee **Infla sus mofletes como un pez globo cuando la metes en el agua**",
      "mensaje_sha256": "cf6e485295b9e0f4d93cd01e07a1cc056e6d1d05e77a98acf2d7e352dd9934a9",
      "tipo_discord": 19,
