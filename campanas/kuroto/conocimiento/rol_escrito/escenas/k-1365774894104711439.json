      "adjuntos": []
    },
    {
      "id": "1365800737782628352",
      "fecha_utc": "2025-04-26T21:24:31.238000+00:00",
      "fecha_local": "2025-04-26",
      "editado_utc": "2025-04-26T21:25:16.655000+00:00",
      "texto": "Samurai: Pues no lo había notado nunca, y llevo ya unas cuatro semanas destinado aquí... Seran cosas de esos yokais **Ves que mira hacia un regimiento de soldados** Si me disculpa, tengo que hacer marcha",
      "mensaje_sha256": "bd0cb8622ce2b92ac7868c02cfaea41947bfb4d99e5daf553cf9cfa773f84702",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362468595212488835/1365800737782628352",
      "texto_sha256": "14f5d9ecbccaadc9b219fa0f4d33f67abbc5fbffdb917d7101c52366f421e302",
      "adjuntos": []
    },
    {
