      "url_discord": "https://discord.com/channels/946724148628041748/1362468595212488835/1365798402540961842",
      "texto_sha256": "ff22732dfe872e5a884c08dfb2d6c0416b9d5547ee39d97986c670fec7064188",
      "adjuntos": []
    },
