    {
      "id": "1442963601899131088",
      "fecha_utc": "2025-11-25T19:42:11.660000+00:00",
      "fecha_local": "2025-11-25",
      "editado_utc": "2025-11-25T19:42:44.731000+00:00",
      "texto": "Erlang Shen:*sabe el valor de las cosas? Quiza sirva para la corte , las boñigas de los bueyes del emperador se acumulan en demasia ultimamente*\n\n baratijas ... \nY dime , conoces desde hace mucho a wukong ?",
      "mensaje_sha256": "852966952e0087c2811e130945d6ba4a92d13a9d0930884958d809a5f82dc33d",
      "tipo_discord": 19,
      "referencia": "1442962495571497224",
