      "texto_sha256": "de3bb6b307b8ae4108eadfc08c9f77797358a53d89bdc710b863f0b52956bbea",
      "adjuntos": []
    },
    {
      "id": "1443518058122711071",
      "fecha_utc": "2025-11-27T08:25:24.325000+00:00",
      "fecha_local": "2025-11-27",
      "editado_utc": null,
      "texto": "Erlang Shen: **ladea un poco la cabeza  y abre un poco el tercer ojo que se ilumina **(dispel magic)\n*y si cierro el portal y se queda sin cabeza , a ver ...*\n**ve que su poder no tiene efecto**\n*uuuu es poderosa la mascota del peregrino Sun*",
      "mensaje_sha256": "477ec250f62b344a3dbce5310b27f965ba99652f9bac733193510eb7d7697c8a",
      "tipo_discord": 19,
      "referencia": "1442965313741258853",
