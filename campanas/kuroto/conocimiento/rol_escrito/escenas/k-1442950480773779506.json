      "texto_sha256": "5b5ea5cf7078b197526ee8cd97283bc461c9e24cd1ac82eacf6d9b2aea2328f0",
      "adjuntos": []
    },
    {
      "id": "1443616295781404734",
      "fecha_utc": "2025-11-27T14:55:46.008000+00:00",
      "fecha_local": "2025-11-27",
      "editado_utc": null,
      "texto": "Erlang Shen : Cuál es tu propósito criatura  Arwen ? Ahora a mi ? \nAaaaaah ! , te refieres a que yo el gran kami de la guerra , líder de los ejércitos del emperador de jade , señor verdadero del místico camino del manantial puro  te lance al viento cual faisan surcando las nubes de las montañas sagradas de los 5 picos ? \nEs eso niña ?",
      "mensaje_sha256": "fbf2d414f9dc3f2af33de3ff34ef935e26ebe5c689b5b7e8d0cfbfbe0ddf9bd8",
      "tipo_discord": 19,
      "referencia": "1443574320663367720",
