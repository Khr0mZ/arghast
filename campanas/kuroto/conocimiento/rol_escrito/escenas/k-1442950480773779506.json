      "adjuntos": []
    },
    {
      "id": "1443574320663367720",
      "fecha_utc": "2025-11-27T12:08:58.360000+00:00",
      "fecha_local": "2025-11-27",
      "editado_utc": null,
      "texto": "Arwen: **Vuelve al poco con la fruta de la misma forma que llego** AHORA A MI AHORA A MIIII",
      "mensaje_sha256": "6be92988a1003556adbd068c4e5ffc6ed846cfd7e95f82e0a583bcd26b8ed65a",
      "tipo_discord": 19,
