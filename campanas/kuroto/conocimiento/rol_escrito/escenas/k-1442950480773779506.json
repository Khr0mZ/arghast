      "texto_sha256": "55d16e7c20828607730115abeacb13fc4ab59122c70790e2bd45b1a1e7946536",
      "adjuntos": []
    },
    {
      "id": "1442965313741258853",
      "fecha_utc": "2025-11-25T19:48:59.795000+00:00",
      "fecha_local": "2025-11-25",
      "editado_utc": null,
      "texto": "Arwen: Uh **Ves que se acerca al borde del tejado, donde crece una pequeña pequeña mala hierva. Sus manos se iluminan en dorado elevandose y esta crece y se abre revelando un portal (Tansladarse via plantas) y se mete de cabeza**",
      "mensaje_sha256": "a87771ae4a8ff445320e1a661cb972621615634f60e0a73fc21af599faeb3ceb",
      "tipo_discord": 19,
      "referencia": "1442964447898370068",
