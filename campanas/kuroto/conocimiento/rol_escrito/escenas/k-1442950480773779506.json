    {
      "id": "1442962495571497224",
      "fecha_utc": "2025-11-25T19:37:47.891000+00:00",
      "fecha_local": "2025-11-25",
      "editado_utc": "2025-11-25T19:38:06.084000+00:00",
      "texto": "Arwen: Ah esas cosas de metal dorado que todo el mundo quiere... Con esa cosa de metal brillante que llevas encima pensaba que tendrias algo... Parece que me equivoque **Le da un mordisco al pomelo y empieza a comerselo** *Ñom ñom ñom*",
      "mensaje_sha256": "995d53cf9520256ba3dcd400764e5d060c7a8dd28de5b19913a402b199c07812",
      "tipo_discord": 19,
      "referencia": "1442961990640472184",
