      "texto_sha256": "4ba1b644059b6111ee48a70c937394094ee2638e42ec9c6664ceec3fe2c8196c",
      "adjuntos": []
    },
    {
      "id": "1442961040508719104",
      "fecha_utc": "2025-11-25T19:32:00.977000+00:00",
      "fecha_local": "2025-11-25",
      "editado_utc": "2025-11-25T19:32:22.083000+00:00",
      "texto": "Arwen: **Ladea la cabeza como un perro atrapando el pomelo entre sus manos** ¿Que son los huvones? ¿Son huevos de algun animal? ¿Y para que quieres tantos?",
      "mensaje_sha256": "d2b47b6ba9ad498792cf7abd953dfab56bb25e21962919743719fa5dd42b1bf2",
      "tipo_discord": 19,
      "referencia": "1442960529105752286",
