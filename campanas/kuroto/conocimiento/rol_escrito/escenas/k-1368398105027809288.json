    },
    {
      "mensaje_id": "1368399399390150727",
      "afirmacion": "Guxi propone comprobar si Kalista volvió a su habitación mientras él dormía.",
      "tipo": "dialogo"
    },
    {
      "mensaje_id": "1368399578054918155",
      "afirmacion": "Nadie responde a la llamada.",
      "tipo": "accion"
    },
    {
