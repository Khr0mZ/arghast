      "adjuntos": []
    },
    {
      "id": "1385253487268466759",
      "fecha_utc": "2025-06-19T13:42:48.130000+00:00",
      "fecha_local": "2025-06-19",
      "editado_utc": null,
      "texto": "Banzo : Nos atacan desde el sur !!!!!\n , rápido vamos con Jelbreg ! \n**te ofrece la mano para salir corriendo **",
