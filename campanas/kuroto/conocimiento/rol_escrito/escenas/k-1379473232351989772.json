      "adjuntos": []
    },
    {
      "id": "1379484055858450613",
      "fecha_utc": "2025-06-03T15:37:08.491000+00:00",
      "fecha_local": "2025-06-03",
      "editado_utc": null,
      "texto": "Kazuki:\n\nDebe volver a su puesto le puedo acompañar si así  lo deseas. \n\n**Sigue serio pero puedes ver que está menos tenso**",
      "mensaje_sha256": "b5f8fe14f96969d7d6ba8463d9b2bbae48586857273c997a332bd6f28234cede",
      "tipo_discord": 19,
      "referencia": "1379483506673061928",
