      "fecha_utc": "2025-12-12T15:11:57.872000+00:00",
      "fecha_local": "2025-12-12",
      "editado_utc": null,
      "texto": "jhin:\npiensa bien la mejor forma de aprender del otro es luchando contra ella \n**le pone una mano en el hombro**\nconfia en mi he entrenado a mucha gente y se lo que te hace falta",
      "mensaje_sha256": "1264128cd1095755e563f0012a5cdf046990f58da98885bfec529ae16f26909a",
      "tipo_discord": 19,
      "referencia": "1449055218984685721",
