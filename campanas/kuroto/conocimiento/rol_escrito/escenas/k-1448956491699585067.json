      "fecha_local": "2025-12-12",
      "editado_utc": null,
      "texto": "jhin:\nsi os parece bien acompañadme \n<@753394009153732689>",
      "mensaje_sha256": "b661bd7cebb53c4c1cbe9ce5c59665379edcea214291eb932b3040f1e5d57685",
      "tipo_discord": 19,
      "referencia": "1449097312109461614",
