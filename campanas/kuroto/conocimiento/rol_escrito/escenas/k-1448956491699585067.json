      "adjuntos": []
    },
    {
      "id": "1449055218984685721",
      "fecha_utc": "2025-12-12T15:08:06.350000+00:00",
      "fecha_local": "2025-12-12",
      "editado_utc": null,
      "texto": "Banzo :  quitate las legañas anda  pensaba que los gatos erais mas limpios .\n\nCon ella tiene que ser ? \nNo puedo contigo y Phalatzier **le dice a jhin ** <@171702246952665098>",
      "mensaje_sha256": "b76099f04d207701f3ac204e479cca071da8038c21c30dd10ac8ded78b4ad0b3",
      "tipo_discord": 19,
      "referencia": "1449052135793623203",
