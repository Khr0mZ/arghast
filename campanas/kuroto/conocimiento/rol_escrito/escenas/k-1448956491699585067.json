    },
    {
      "id": "1449097312109461614",
      "fecha_utc": "2025-12-12T17:55:22.133000+00:00",
      "fecha_local": "2025-12-12",
      "editado_utc": null,
      "texto": "Banzo : **gruñe un poco e onfla los mofletes **\nBueno.... como digas",
      "mensaje_sha256": "c51df44ec29ceba91c9a5eb262440b6cdfb36c5335745cde1f3b1416abef2aa2",
      "tipo_discord": 19,
