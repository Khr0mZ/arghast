      "texto_sha256": "db8f51ceda119a19b2717a64857ea2add3501760021189860c3a040faf94b657",
      "adjuntos": []
    },
    {
      "id": "1449051405519159428",
      "fecha_utc": "2025-12-12T14:52:57.149000+00:00",
      "fecha_local": "2025-12-12",
      "editado_utc": null,
      "texto": "Banzo ** te pone cara de chupar un limón al sol y mira a ver Shirz esta cerca** \nPues aun no pero si te prestas voluntaria ... \n\nSi Jhin , porfavor necesito aprender de todos .",
      "mensaje_sha256": "901b2ca5aa5c50b0889fdb67e1b864d91bfc4bfb33ef710c969ae5eb67b66749",
      "tipo_discord": 19,
      "referencia": "1449050187031904411",
