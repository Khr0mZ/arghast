    },
    {
      "id": "1368541857214234715",
      "fecha_utc": "2025-05-04T10:56:45.038000+00:00",
      "fecha_local": "2025-05-04",
      "editado_utc": null,
      "texto": "Palathier: ** Dejando el plato de gachas ya frías en la mesita de al lado de la cama, mirará lo que sostiene Banzo** *qué verguenza...como me hagan leer...todos estos años aletargada...a ver que es eso..?*",
      "mensaje_sha256": "0885e0f9dbb3932103bb92ffb0ff6f5890bfdb47d47473b78886bff851dfc5e2",
      "tipo_discord": 0,
      "referencia": null,
