    {
      "id": "1366071386321457163",
      "fecha_utc": "2025-04-27T15:19:58.878000+00:00",
      "fecha_local": "2025-04-27",
      "editado_utc": null,
      "texto": "Banzo: mmm, entiendo.  Donde me crié tampoco queda gran cosa , y los que quedan están en la guerra . \n\nY como era tu tierra ? Habían muchas montañas y tierras heladas ? Nono seguro que habían unos bosques inmensos **ves como va diciendo el goliath mientras te mira con gesto sonriente e ilusionado **",
      "mensaje_sha256": "f6197621560faf401e3edc81969e76027f372c7d80f3ea1f65c6bd43cace5e2c",
      "tipo_discord": 19,
      "referencia": "1366070056181694617",
