      "texto_sha256": "3f8b766bf0e71b06e83cfee90ba6c1bfc217f1df5505f3b950e09d7bf1d20fe7",
      "adjuntos": []
    },
    {
      "id": "1372990256126623835",
      "fecha_utc": "2025-05-16T17:33:05.986000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Kurobane:\n\nNo diré nada. Puedes confiar en mi. Pero si quieres que vende los ojos, lo haré.",
      "mensaje_sha256": "dcab8595383bb842bb13ddf1bd317aed142ad66137ff40d65838285da1db5967",
      "tipo_discord": 19,
      "referencia": "1372989992112230512",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1372990256126623835",
      "texto_sha256": "23c20a3aaa17e9a9c53bdabddfcd6364023d7813a50996847e0e46e23e88ad87",
      "adjuntos": []
    },
    {
      "id": "1372990485542735953",
      "fecha_utc": "2025-05-16T17:34:00.683000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Guxi: si me haces el favor lo agradezco ese lugar tiene valor sentimental para mi y me gustaria que no fuera publico",
      "mensaje_sha256": "d6bafbdc6f4bb24464673bbcddcca93a52c657151149ccd9ddf28c0f3bc401a7",
      "tipo_discord": 19,
      "referencia": "1372990256126623835",
