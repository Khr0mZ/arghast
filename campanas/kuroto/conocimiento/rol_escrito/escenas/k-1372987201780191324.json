      "fecha_utc": "2025-05-16T17:28:20.910000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Kurobane:\n\nFue y es mi centro de operaciones. La encontré mucho antes de ir a Sho.\n\n**Dice serio mientras mira por dentro de su capa**",
      "mensaje_sha256": "0bc7837c43a418ffc03e52b97b06c376d2568f9583144b1089a79c2dfe109708",
      "tipo_discord": 19,
      "referencia": "1372988592317661315",
