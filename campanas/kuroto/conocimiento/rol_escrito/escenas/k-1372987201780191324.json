      "adjuntos": []
    },
    {
      "id": "1372988025230856293",
      "fecha_utc": "2025-05-16T17:24:14.099000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "guxi: **cuando llevas ya unos minutos es un pajaro es un avion es guxi aparece volando y aterriza delante tuya** buenas kurobane como estas?",
      "mensaje_sha256": "09bf625b55b50600fe7123aa0a58fddb2315d79baca53b3c2bff1eb0423697ed",
      "tipo_discord": 19,
      "referencia": "1372987755591892992",
