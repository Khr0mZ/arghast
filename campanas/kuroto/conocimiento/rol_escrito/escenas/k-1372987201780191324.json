      "texto_sha256": "1784b06c354e087f3a7c469d95c050b228a50e1118d01611fbc0eed7793d61dc",
      "adjuntos": []
    },
    {
      "id": "1372989721453662359",
      "fecha_utc": "2025-05-16T17:30:58.510000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Kurobane:\n\nNada, solo que alguien quito la ilusión que la cubría. Pero ya la he arreglado por eso he tardado más de lo habitual. Tienes algún sitio más privado?",
      "mensaje_sha256": "c4a0d5ddd369ba3b4c846cce90accee90dffb82dc0a7441101c850b6b06d60c2",
      "tipo_discord": 19,
