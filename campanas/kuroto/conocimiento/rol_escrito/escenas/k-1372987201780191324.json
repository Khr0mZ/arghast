      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "guxi: **le pone la venda en los ojos a Kurobane y le coge de la mano** gracias seran unos minutos no te preocupes",
      "mensaje_sha256": "7eab802c85ac3e169a003647b0b3511ccf27f65f0f98d620a522e35b74312605",
      "tipo_discord": 19,
      "referencia": "1372991100020850782",
