      "texto_sha256": "233452d844e9be583a4546b9f6ea770475f5268e7ec86441aaa98e0bb352b524",
      "adjuntos": []
    },
    {
      "id": "1372989293173280870",
      "fecha_utc": "2025-05-16T17:29:16.400000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Guxi: es una lastima que le ha pasado ? si se puede saber ** se sienta al lado tuya en esa piedra**",
      "mensaje_sha256": "1ab2d07c1fa137403233d1a3eaae5e76524671c0aff0074122c6664aa574be9b",
      "tipo_discord": 19,
      "referencia": "1372989060431482901",
