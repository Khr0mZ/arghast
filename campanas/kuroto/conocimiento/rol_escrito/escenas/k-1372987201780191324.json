      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Kurobane:\n\n*Me ha dicho que me quede por aquí*",
      "mensaje_sha256": "9620711efbc7302dc4714f466c20c976b54437eb9f0ea1fa1d5eca5f41bbd5a6",
