      "texto_sha256": "524dc5c5b16a92330810256ce260bdc96da9c2f205b98fa9d7487db1748a201f",
      "adjuntos": []
    },
    {
      "id": "1372988592317661315",
      "fecha_utc": "2025-05-16T17:26:29.303000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Guxi: no sabia que tenias una base oculta en el sur . Pensaba que era el unico por aqui con un refugio asi",
      "mensaje_sha256": "3805111a5eafd655f0fb76fcbec5b3714405c5d99cb6038b83292cdb18c9f90e",
      "tipo_discord": 19,
      "referencia": "1372988372997378178",
