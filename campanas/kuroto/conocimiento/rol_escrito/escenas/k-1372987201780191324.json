      "texto_sha256": "91ea6aaed197be0ad33107905ed53053eea3611b43fa4b6b86b5cddfab2ea8f8",
      "adjuntos": []
    },
    {
      "id": "1372988372997378178",
      "fecha_utc": "2025-05-16T17:25:37.013000+00:00",
      "fecha_local": "2025-05-16",
      "editado_utc": null,
      "texto": "Kurobane:\n\nUn poco cansado, alguien quito la ilusión que protege mi base en el sur.\n\n**Dice serio mientras mira como has aterrizado**",
      "mensaje_sha256": "543d2f0b04431668238fceeba72d5382df3b08ed4fa1472317808edabb922429",
      "tipo_discord": 19,
      "referencia": "1372988025230856293",
