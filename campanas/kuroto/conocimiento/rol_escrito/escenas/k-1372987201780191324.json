      "fecha_local": "2025-05-16",
      "editado_utc": "2025-05-16T17:32:11.111000+00:00",
      "texto": "guxi: si , no me importaria llevarte pero te importa ponerte esto **te da un pañuelo para que te cubras** me gustaria mantenerlo en secreto si es posible <@240564189448503306>",
      "mensaje_sha256": "1c0c1f685ad38c5853c2c18da7d79e8e179e289c86662d76843c5e4cd760c628",
      "tipo_discord": 0,
      "referencia": null,
