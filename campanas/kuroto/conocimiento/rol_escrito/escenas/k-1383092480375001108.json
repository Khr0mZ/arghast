    },
    {
      "id": "1383107836191445044",
      "fecha_utc": "2025-06-13T15:36:45.049000+00:00",
      "fecha_local": "2025-06-13",
      "editado_utc": null,
      "texto": "Seraphina:\nAnda vamos, pero dejame vestirme primero, no creo que te guste que me vean de esta manera \n\n**Me levanté de la cama y tome mis prendas para poder vestirme**\n\nMe sorprende que haya llegado hasta aquí remando, menos mal di con tierra y no morí en medio del mar",
      "mensaje_sha256": "688eba317ae7736dd5e378e0cca61531a3503d21f1791cce60125ffe3f88d114",
      "tipo_discord": 19,
      "referencia": "1383106697337245756",
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1383107836191445044",
      "texto_sha256": "c17513b121b273c2e852eafff1948bb90b52139bd2c346297f939ec6d680ed48",
      "adjuntos": []
    },
    {
