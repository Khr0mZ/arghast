    {
      "id": "1383096215595651182",
      "fecha_utc": "2025-06-13T14:50:34.483000+00:00",
      "fecha_local": "2025-06-13",
      "editado_utc": null,
      "texto": "Seraphina: \n**me reincorporé, con el pelo alborotado y una sonrisa en el rostro**\n\nTu eres el que dirige por el momento, yo simplemente dejaré que tú me guíes, corazón",
      "mensaje_sha256": "543b39d9461b7d819928ed77728dde0062ea2668312c2f472e7f41585cb7103f",
