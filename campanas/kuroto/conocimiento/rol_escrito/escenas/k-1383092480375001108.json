      "texto_sha256": "e81ab7f76087892b90065f60b1f71711a906c00921195940bfb09a244f042023",
      "adjuntos": []
    },
    {
      "id": "1383106697337245756",
      "fecha_utc": "2025-06-13T15:32:13.525000+00:00",
      "fecha_local": "2025-06-13",
      "editado_utc": null,
      "texto": "Guxi: solo a las más preciosas **le guiña un ojo** bueno quieres venir?",
      "mensaje_sha256": "b12977b7c1068b2cd116349124c7e84f04d266746aee0a759877ce0ded76364b",
      "tipo_discord": 19,
      "referencia": "1383105521501864028",
