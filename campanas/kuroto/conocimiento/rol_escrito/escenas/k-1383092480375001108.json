    },
    {
      "id": "1383111131073089697",
      "fecha_utc": "2025-06-13T15:49:50.610000+00:00",
      "fecha_local": "2025-06-13",
      "editado_utc": null,
      "texto": "Seraphina:\nNah, hubiese muerto, estaba bastante ebria, bueno... Siempre lo estoy jaja\n\n**Terminé de vestirme y me puse atrás de el, apegandome a su espalda en un abrazo**\n\nNos vamos?~",
      "mensaje_sha256": "cf22e15211243345c70a700700759457cbbce355fc27f73f4172f58e0e6a2c57",
