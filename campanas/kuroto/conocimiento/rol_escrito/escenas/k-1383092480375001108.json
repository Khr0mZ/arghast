      "texto_sha256": "8b59e05cdc75347875997b5923a028c26963127e7f9a78d340b8901475e88ec0",
      "adjuntos": []
    },
    {
      "id": "1383097926259183697",
      "fecha_utc": "2025-06-13T14:57:22.337000+00:00",
      "fecha_local": "2025-06-13",
      "editado_utc": null,
      "texto": "Guxi: bueno **se levanta y hace una reverencia** me acompaña mylady tengo asuntos que atender y nunca está de más la compañía de alguien tan bella",
      "mensaje_sha256": "fd8ca423e1dee557fc7346ecb32d496caed7592570ae197ff9de0dc1c2a1ae51",
      "tipo_discord": 19,
      "referencia": "1383096215595651182",
