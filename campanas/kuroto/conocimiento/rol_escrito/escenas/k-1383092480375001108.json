      "texto_sha256": "31336bb6bde54083070980ca810695b57f501c6233f093b43c5417c11a9a1ae8",
      "adjuntos": []
    },
    {
      "id": "1383105521501864028",
      "fecha_utc": "2025-06-13T15:27:33.184000+00:00",
      "fecha_local": "2025-06-13",
      "editado_utc": null,
      "texto": "Seraphina:\n**Levante de nuevo la ceja y sonreí un poco ruborizada**\n\nTe aseguro que eso le dices a toda mujer que te rodea, es imposible que no se fijen en tí",
      "mensaje_sha256": "3d1b362e34fa971aff4800e957c4ed0c2466593acf34b66f89f08fbe0f10bfd6",
      "tipo_discord": 19,
      "referencia": "1383097926259183697",
