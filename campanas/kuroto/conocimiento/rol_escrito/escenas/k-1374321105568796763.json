      "texto_sha256": "c06fe2a3289e802c7243c07a8a5735fe0030cc1f8e560ea4dd83d0ca5a140644",
      "adjuntos": []
    },
    {
      "id": "1374329367517204531",
      "fecha_utc": "2025-05-20T10:14:15.021000+00:00",
      "fecha_local": "2025-05-20",
      "editado_utc": null,
      "texto": "Guxi: **lleváis ya un buen rato trabajando y el barco va tomando forma cuando el silencio es roto por guxi** sabes kurobane siempre he trabajado solo pensaba que era la mejor forma de que todo se hiciera correctamente, pero me habéis enseñado vosotros a confiar en otros y apoyarme en otros .Te importa si te llamo amigo?",
      "mensaje_sha256": "57b117a0e25d8ae90dbe1ba4fc84e5bb892418dc16869908d14901ada32305c9",
      "tipo_discord": 19,
      "referencia": "1374326688657444926",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1374329367517204531",
      "texto_sha256": "36082d80b73b79c2dd51bdcc1c6e2795307f61ec51536ee031abc71ef4506cc0",
      "adjuntos": []
    },
    {
