      "adjuntos": []
    },
    {
      "id": "1374326688657444926",
      "fecha_utc": "2025-05-20T10:03:36.331000+00:00",
      "fecha_local": "2025-05-20",
      "editado_utc": null,
      "texto": "Kurobane:\n\n**Asiente sonriente**\n\nContinuemos",
      "mensaje_sha256": "2cd5cd79e1b7bee5dac3add73d9eaf3225e2148b1d191a62444d386266360af9",
      "tipo_discord": 19,
      "referencia": "1374326456888590348",
