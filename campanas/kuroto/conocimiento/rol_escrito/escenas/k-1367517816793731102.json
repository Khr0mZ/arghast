      "texto_sha256": "c2993e6cbf28b870842d4b5c08be091ef7c55e9171ccb6a7945e1355b412b134",
      "adjuntos": []
    },
    {
      "id": "1367524703358419044",
      "fecha_utc": "2025-05-01T15:34:56.661000+00:00",
      "fecha_local": "2025-05-01",
      "editado_utc": null,
