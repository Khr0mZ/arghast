      "texto_sha256": "1ac66647cab6581e9a98907292dce16011ce979db5844c832d9bb370c8f819a1",
      "adjuntos": []
    },
    {
      "id": "1389537808015687711",
      "fecha_utc": "2025-07-01T09:27:09.795000+00:00",
      "fecha_local": "2025-07-01",
      "editado_utc": null,
      "texto": "Banzo : hola señorita.  Venía a ver a la señora Fukami.  Se encuentra en casa ?",
      "mensaje_sha256": "cc180147ba06269e1a89a5ad77e1b1b7ebe9d002ddba4cc6d66d8136d207ef86",
