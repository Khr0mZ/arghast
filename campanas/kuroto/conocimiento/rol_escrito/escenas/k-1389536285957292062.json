      "fecha_local": "2025-07-01",
      "editado_utc": null,
      "texto": "Banzo : a no? Menos mal ... \nY quien crees tu que está mejor situado ?",
      "mensaje_sha256": "eab97f3b9bb8c61578d2d9d47d49354068e1e2291262ad097a301f1eb432b653",
      "tipo_discord": 19,
