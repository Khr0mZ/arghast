      "texto_sha256": "3a24e4d15789b2a5de0292374c6126cf3da3fb272538b5225141e82e8bb3832a",
      "adjuntos": []
    },
    {
      "id": "1389538158382940243",
      "fecha_utc": "2025-07-01T09:28:33.329000+00:00",
      "fecha_local": "2025-07-01",
      "editado_utc": null,
      "texto": "Sirvienta: **Os mira de arriba abajo** Si, la señora esta en casa. ¿Quiénes la desean ver? ¿Y para que?",
      "mensaje_sha256": "b68322a00ce42ba97c5d2bb887231a573cac26c2b45b22c57c25c5537275e381",
