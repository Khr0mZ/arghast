    {
      "id": "1387353403042168892",
      "fecha_utc": "2025-06-25T08:47:07.065000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": "2025-06-25T08:48:42.729000+00:00",
      "texto": "???:\n\nMe puede llamar Kazuha. Por el momento.\n\n**Dice serio mientras observa su alrededor**",
      "mensaje_sha256": "c84c3c3ce8301f06de9c3ad38129047c11710602f717fc1da6afd027e8112427",
      "tipo_discord": 19,
      "referencia": "1387352850182574090",
