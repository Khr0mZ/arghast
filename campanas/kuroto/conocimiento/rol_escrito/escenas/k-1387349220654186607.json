      "texto_sha256": "4fcf8a0fae83954efab31c0e6f351959545a604b1862a2ba6323b2ee2ca30eb2",
      "adjuntos": []
    },
    {
      "id": "1387355254642966550",
      "fecha_utc": "2025-06-25T08:54:28.521000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": "2025-06-25T08:55:12.750000+00:00",
      "texto": "\"Kazuha\":\n\nDe donde yo vengo, he podido parar al anterior rey demonio devastara todo ese mundo con una maquina gigante. Soy un diestro guerrero y se me da bien las artes mágicas, también.\n\n**Dice serio mientras clava su mirada en tus ojos**",
      "mensaje_sha256": "fa3d4d9a633578921e627aba4faf894c15cd90fde1dd9bd711caebb767433f1d",
      "tipo_discord": 19,
      "referencia": "1387354323242975352",
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1387355254642966550",
      "texto_sha256": "404f1032463f4b5845220c03917f19b90ebeed13a698d8427563b2e6750d266a",
      "adjuntos": []
    },
    {
      "id": "1387355497778122912",
      "fecha_utc": "2025-06-25T08:55:26.489000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "Kalista: **Te mantiene la mirada sin titubear** ¿Le importaria mostrarmelo?",
      "mensaje_sha256": "c6cd4b8cc86de0bbe55d643759dc6f2f9b4eabb36271be8ca17bfcf122ae2aee",
      "tipo_discord": 19,
      "referencia": "1387355254642966550",
