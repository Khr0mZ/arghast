      "texto_sha256": "8d694ad55568711eedc278fa31c13982b99d0126eabe5654f32dfcb5d263c012",
      "adjuntos": []
    },
    {
      "id": "1387354323242975352",
      "fecha_utc": "2025-06-25T08:50:46.458000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "Kalista: **Se queda mirandolo unos segundos largos** Bien señor Kazuha, digame ¿Que habilidades tiene? Como vera los cazadores no son gente comun",
      "mensaje_sha256": "aeec7d8f5bc09a06b83a208d8756c70cc17c0a0b6008608b7a95f9e1c2c335fc",
      "tipo_discord": 19,
      "referencia": "1387353403042168892",
