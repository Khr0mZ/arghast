    },
    {
      "id": "1387350231779115060",
      "fecha_utc": "2025-06-25T08:34:30.977000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "Kalista: **Se le queda mirando** ¿Viene a un encargo o...?",
      "mensaje_sha256": "964896a6c3114679a8af9b2c274f4f3844f141c53fef6a48481697e11a9afb0c",
      "tipo_discord": 19,
