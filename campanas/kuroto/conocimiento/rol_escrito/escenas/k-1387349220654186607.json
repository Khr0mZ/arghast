      "texto_sha256": "0e225925e74bb432ae7d11a673b25ecf7d9b3ab3ed44b9bca53c38fbf61957d0",
      "adjuntos": []
    },
    {
      "id": "1387360178583896196",
      "fecha_utc": "2025-06-25T09:14:02.480000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "Archi: **Le entrega un tubo , con el mapa dentro y otro papel con las instrucciones.  Le da una runa que el también tiene y le dice \n**aquí tienes la runa de activación.  Recuerda . Que paxa mapa, y se activará.  Lo mismo y se apagará.",
      "mensaje_sha256": "069904b5700cdc006b70cf5fd30051ab0385247dd97ce0c30dc71d3a1428cee2",
      "tipo_discord": 19,
      "referencia": "1387344923925286962",
