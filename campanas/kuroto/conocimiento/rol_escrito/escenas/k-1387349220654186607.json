    },
    {
      "id": "1387352850182574090",
      "fecha_utc": "2025-06-25T08:44:55.253000+00:00",
      "fecha_local": "2025-06-25",
      "editado_utc": null,
      "texto": "Kalista: **Va con el** ¿Podria primero saber su nombre?",
      "mensaje_sha256": "1a7325a69d6f1896332864a06ffd489bd4d1156c98a761abc1b37327f5c57316",
      "tipo_discord": 19,
