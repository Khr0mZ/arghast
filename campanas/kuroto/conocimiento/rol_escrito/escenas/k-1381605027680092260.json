      "adjuntos": []
    },
    {
      "id": "1381606889443561627",
      "fecha_utc": "2025-06-09T12:12:31.458000+00:00",
      "fecha_local": "2025-06-09",
      "editado_utc": "2025-06-09T12:17:32.017000+00:00",
      "texto": "jhin: muchas gracias ** se dirige hacia el lugar indicado**",
      "mensaje_sha256": "23ac2e76fa0438aedea3710aea4d33dc9ad499bb8e610942603c06563ff8250f",
      "tipo_discord": 19,
      "referencia": "1381606627035316274",
