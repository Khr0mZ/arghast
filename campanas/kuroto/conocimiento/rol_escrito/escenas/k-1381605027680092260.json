    },
    {
      "id": "1381606627035316274",
      "fecha_utc": "2025-06-09T12:11:28.895000+00:00",
      "fecha_local": "2025-06-09",
      "editado_utc": null,
      "texto": "Guardia: Pues... Supongo que estará en la herrería, allí atrás **Te señala un camino por detrás de los barracons de los soldados**",
      "mensaje_sha256": "9874502f4b1a4fed52a8ae45b95159e88b04136bf60282cfb51fa2849f9586a6",
      "tipo_discord": 19,
      "referencia": "1381605027680092260",
