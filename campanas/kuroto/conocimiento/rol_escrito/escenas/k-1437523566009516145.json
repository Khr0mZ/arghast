      "texto_sha256": "45732b214717e30a48e988ab46f493197d087902804d64704a710d4cf4b18040",
      "adjuntos": []
    },
    {
      "id": "1437575536430809211",
      "fecha_utc": "2025-11-10T22:51:56.747000+00:00",
