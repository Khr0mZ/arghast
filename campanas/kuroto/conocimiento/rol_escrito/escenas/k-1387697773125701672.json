      "texto_sha256": "7bd2abea0620eacb2bc6f910123ddb6a6beaf2e56d93c725baf5c3e28b770f32",
      "adjuntos": []
    },
    {
      "id": "1387761678959116411",
      "fecha_utc": "2025-06-26T11:49:27.629000+00:00",
      "fecha_local": "2025-06-26",
      "editado_utc": null,
      "texto": "Jelbreg: **Te pisa el pie para que te calles, ya que se ha olvidado de comprarlas y no quiere que Kalista se entere** Uy, perdona Banzo.... **Dice mientras se acerca a ti y te susurra** Calla... que sino me cae la bronca... compra ácidas.",
      "mensaje_sha256": "998a4b54affb83f5779f93a36ed3cee05657f22291cb4fb9e5489f62d788ef5c",
      "tipo_discord": 19,
      "referencia": "1387760986651365426",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1387761678959116411",
      "texto_sha256": "9f9256428ad3b7026ed860faefd79522b03dfed7e4a6f236afa535f05b996d66",
      "adjuntos": []
    },
    {
