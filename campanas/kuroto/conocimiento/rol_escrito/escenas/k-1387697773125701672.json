      "texto_sha256": "1ae9db9988d111881e6f67393294afc58d8402f2450c0933b79d5eb90bbd5ce6",
      "adjuntos": []
    },
    {
      "id": "1387713797124259953",
      "fecha_utc": "2025-06-26T08:39:11.710000+00:00",
      "fecha_local": "2025-06-26",
      "editado_utc": null,
      "texto": "Jelbreg: ¿No crees que lo estas exagerando? **Se acerca a Kalista y sigue susurrando** ¿Tu que piensas? <@753394009153732689>",
      "mensaje_sha256": "30d81118ae79ebe496c082c516e96cea983474162e6966ae38633b672ce7dfcd",
      "tipo_discord": 19,
      "referencia": "1387709379012333719",
