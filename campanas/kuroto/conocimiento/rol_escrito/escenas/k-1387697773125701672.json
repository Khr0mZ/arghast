      "texto_sha256": "677bf3428e83b517b90289e8f95f844dbbb72f8a483fb594476bb67fca2cbaf8",
      "adjuntos": []
    },
    {
      "id": "1387718246760714241",
      "fecha_utc": "2025-06-26T08:56:52.586000+00:00",
      "fecha_local": "2025-06-26",
      "editado_utc": null,
      "texto": "Banzo : *quizá tenga razón*\n**sin responder se dirige pensativo hacia la ventana y sigue observando con gesto preocupado **",
      "mensaje_sha256": "63161fdf2b6dc41f3ac3de2f8db9d8fffe4da35945aefb0fa8b951e30195fc0d",
      "tipo_discord": 19,
      "referencia": "1387713797124259953",
