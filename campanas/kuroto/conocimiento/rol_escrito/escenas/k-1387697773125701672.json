    },
    {
      "id": "1387709379012333719",
      "fecha_utc": "2025-06-26T08:21:38.350000+00:00",
      "fecha_local": "2025-06-26",
      "editado_utc": null,
      "texto": "Banzo : Quizá kalista podría sacar algo de información sin dar mucho detalles **le susurra a jelbreg y mira a Kalista **",
      "mensaje_sha256": "cc36807ef9ec0813544f5999bef276e967b59682cb127ffac847f820ac7461fd",
      "tipo_discord": 19,
      "referencia": "1387701918171922516",
