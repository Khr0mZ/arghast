    },
    {
      "id": "1379758795546427518",
      "fecha_utc": "2025-06-04T09:48:51.537000+00:00",
      "fecha_local": "2025-06-04",
      "editado_utc": null,
      "texto": "**Escucháis el leve tambalear del cristal sobre la mesa. Un resplandor azul intenso comienza a emanar de su interior, inundando la habitación con una luz cegadora. De no ser por esas extrañas gafas que ambos lleváis puestas, la visión os habría abandonado al instante. Entonces, un estruendo retumba en el despacho de Guxi, como el estallido de un trueno contenido… y después, nada. Silencio. Un silencio denso, incómodo, casi antinatural. El cristal permanece allí, inmóvil sobre la mesa. Sin brillo.**",
      "mensaje_sha256": "8bce8bd65351783559b664b6c4595ee5aa4035be5c2ca69547c8531102888a06",
      "tipo_discord": 0,
      "referencia": null,
