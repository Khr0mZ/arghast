    },
    {
      "id": "1365395873592250378",
      "fecha_utc": "2025-04-25T18:35:44.093000+00:00",
      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Kalista: **No te es dificil verla en uno de los muelles viendo el mar**",
      "mensaje_sha256": "f6d1dd2013af5cc531c6ad221de80e050ab19a9dc8218aa005a0f4157f7549f4",
      "tipo_discord": 19,
      "referencia": "1365395511309238302",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1365395873592250378",
