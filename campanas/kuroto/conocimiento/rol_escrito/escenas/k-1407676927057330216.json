      "fecha_local": "2025-08-20",
      "editado_utc": null,
      "texto": "Ring ring Banzo : Jelbreg  , tenemos un problema.  \nDos mas bien...",
      "mensaje_sha256": "311810b61a47b2b288c939f0b9b65283fd37406e2f806e0615c1bc9b25bc6f18",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1387915737502580886/1407676927057330216",
      "texto_sha256": "efe912d720136bdb29d4e721be0df78dd1ce3496a52d0b02bcba99ede3e8de09",
