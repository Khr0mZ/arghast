    },
    {
      "id": "1362710160342253619",
      "fecha_utc": "2025-04-18T08:43:40.156000+00:00",
      "fecha_local": "2025-04-18",
      "editado_utc": null,
      "texto": "Ikaari: no está muy lejos, según Jelbreg a menos de 1 hora. No tenemos pruebas contra Danifae, no sería sensato lanzarse contra ella *aún que ganas no me faltan* **aguanta la compostura mientras aprieta los puños**\nNos limitaremos a investigar y volveremos. Si?",
      "mensaje_sha256": "3e4a52e10a13c1abdd209ffaee9ba498b1a0b4cbd312f76acccd68fa05ea5175",
      "tipo_discord": 0,
      "referencia": null,
