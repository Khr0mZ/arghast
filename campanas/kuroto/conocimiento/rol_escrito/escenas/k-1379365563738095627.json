    },
    {
      "id": "1379505665747325090",
      "fecha_utc": "2025-06-03T17:03:00.690000+00:00",
      "fecha_local": "2025-06-03",
      "editado_utc": null,
      "texto": "**Podrías ver que la piedra está compuesta por un material bastante extraño. Esta sacada de un tipo de roca exclusivo de las tierras de Ashenoth, se dice que la magia de nigromancia es tan poderosa que acaba afectando a esas tierras. Al intentar hacerla reaccionar con algunos materiales, la piedra empieza a temblar de manera extraña. No parece estable**",
      "mensaje_sha256": "d4c484b667850d9559774ba0e3f37d6e0b453b2a614a0ba53f998e67c0b33f86",
      "tipo_discord": 19,
      "referencia": "1379503400747663541",
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1379505665747325090",
