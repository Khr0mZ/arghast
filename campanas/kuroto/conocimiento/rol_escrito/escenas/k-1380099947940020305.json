      "fecha_local": "2025-06-05",
      "editado_utc": null,
      "texto": "Arwen: ....eso no esta bien.... No debe hacer mal la naturaleza....¿Te quedaras con Arwen...? Tengo miedo....de que no sirva el poder",
      "mensaje_sha256": "9b77506cc0dc620a234ee97beeba4e67c127ced187afbfe7f790415d6ec01a3a",
      "tipo_discord": 19,
      "referencia": "1380111793887641700",
