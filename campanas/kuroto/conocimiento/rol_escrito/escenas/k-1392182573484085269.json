    },
    {
      "mensaje_id": "1392201642077716551",
      "afirmacion": "La narración confirma que Jelbreg es sincero en su amenaza dentro del círculo.",
      "tipo": "accion"
    },
    {
      "mensaje_id": "1392203611588661419",
