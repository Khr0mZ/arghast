    },
    {
      "id": "1439374162740383808",
      "fecha_utc": "2025-11-15T21:59:02.676000+00:00",
      "fecha_local": "2025-11-15",
      "editado_utc": null,
      "texto": "Shirz: **El shadar-kai te mira al asomarte y te muestra una sonrisa complaciente. Sigue sentado en la cama haciéndole compañía a la niña** Un placer verte otra vez, líder Banzo",
      "mensaje_sha256": "f09d3e53af247b53b0faeccdaf3980b6d7fea57a1758bb9d6a26e701330e009a",
      "tipo_discord": 19,
      "referencia": "1439373391617462322",
