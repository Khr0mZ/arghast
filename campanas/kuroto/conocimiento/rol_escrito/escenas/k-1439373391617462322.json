      "adjuntos": []
    },
    {
      "id": "1439386320819589140",
      "fecha_utc": "2025-11-15T22:47:21.388000+00:00",
      "fecha_local": "2025-11-15",
      "editado_utc": null,
      "texto": "Chanecuxtli:\n**Abrí mis alitas para poder darle un abrazo mientras le piaba quedito, casi como un susurro**\n\nTodo va a estar bien, pío, te lo prometo",
      "mensaje_sha256": "2d6d8ad19b7e0a8045ad0054a7ade8ecae97509bc950b6cd80cfc4d9360f7453",
      "tipo_discord": 19,
      "referencia": "1439385966203633776",
