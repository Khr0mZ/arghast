      "adjuntos": []
    },
    {
      "id": "1373685340774072461",
      "fecha_utc": "2025-05-18T15:35:07.080000+00:00",
      "fecha_local": "2025-05-18",
      "editado_utc": null,
      "texto": "Rua: Tranquilo, puedes ir a descansar. **La ves desaparecer por la esquina del largo pasillo junto a la sirvienta**",
      "mensaje_sha256": "cccabd5ba42f48f320de5764994235a1a34ccc78af64623c82c55b9725eb71e7",
      "tipo_discord": 19,
      "referencia": "1373684833942900816",
