      "adjuntos": []
    },
    {
      "id": "1373683305492250685",
      "fecha_utc": "2025-05-18T15:27:01.831000+00:00",
      "fecha_local": "2025-05-18",
      "editado_utc": null,
      "texto": "Banzo : *no quiero meterla en líos,  últimamente soy experto en eso* \n** guarda la bata en la mochila ** \nVes ... recursos no me faltan ,   tardo 2 días en leer una página y entenderla bien pero se hacer planes \n**sonrrie **",
      "mensaje_sha256": "19716292234ed5c7de3e04e747dcf556acae1e60164974bcb31a96e2045c1f5f",
      "tipo_discord": 19,
      "referencia": "1373678435494269059",
