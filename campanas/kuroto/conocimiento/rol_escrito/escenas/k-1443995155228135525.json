      "fecha_local": "2025-11-28",
      "editado_utc": null,
      "texto": "Guxi:\nNo me voy a librar de ti nunca ni aunque el mismo mundo se de la vuelta \nTendremos que darnos prisa para salvar kuroto entonces",
      "mensaje_sha256": "d276eb00472a34a3ceeb41d4c38349cfffc9c3318f4b89e02d57a68ecb089004",
      "tipo_discord": 19,
      "referencia": "1444017569169412211",
