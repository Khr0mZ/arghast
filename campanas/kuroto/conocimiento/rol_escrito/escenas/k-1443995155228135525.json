      "fecha_local": "2025-11-28",
      "editado_utc": null,
      "texto": "Guxi:\nNo te preocupes cariño lo haré  \n**Aprovecha la cercanía de darle un beso en los labios**\nY tú ten cuidado",
      "mensaje_sha256": "1293f0fa097594ffaddb266ea31bc1a2a3c1c192712905be93fd5361bf9a096e",
      "tipo_discord": 19,
      "referencia": "1444010721414353007",
