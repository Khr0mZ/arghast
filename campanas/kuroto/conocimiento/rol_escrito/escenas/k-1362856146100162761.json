      "adjuntos": []
    },
    {
      "id": "1362861943093854442",
      "fecha_utc": "2025-04-18T18:46:47.984000+00:00",
      "fecha_local": "2025-04-18",
      "editado_utc": null,
      "texto": "Aka:\n\n**Se queda un poco perpleja al leer el panfleto**\n\n*Creo que pasare. Ademas ya tengo un vestido de tsugami de cuando fuimos al Baile*\n\n**Se dirige hacia dentro de la base para buscar a Banzo**",
      "mensaje_sha256": "c6441ef62a807182327055bc2af7b389fe30f16543c4b1611bae6530494d7a1d",
      "tipo_discord": 0,
      "referencia": null,
