      "texto_sha256": "43386a53225426d075136bf5863359fec6735c3d4a3be6136d3883d5cdf40063",
      "adjuntos": []
    },
    {
      "id": "1362862458414301244",
      "fecha_utc": "2025-04-18T18:48:50.846000+00:00",
      "fecha_local": "2025-04-18",
      "editado_utc": null,
      "texto": "**Un panfleto se te estampa parece con una fuerza impropia de un papel.... Ves como la abuela parece pegarte con un rollo de tela....Pero parece ser tu imaginacion ¿No?**",
      "mensaje_sha256": "65c0c0dbfc60657fe43a773b5c76fd83c45befb6277d3fb341fe954e906262db",
      "tipo_discord": 19,
      "referencia": "1362861943093854442",
