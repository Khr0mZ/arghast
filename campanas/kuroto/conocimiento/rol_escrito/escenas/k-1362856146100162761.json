      "editado_utc": null,
      "texto": "Kurobane: **sale por el portal**\n*creo que podré conseguir mas información aquí antes de irme al sur*\n**tocaría a la puerta de la base**",
      "mensaje_sha256": "2798f7b37fc1cf19b266c26b6d62a2ab8ab2d141d7cbc052e6b84394a95e35ee",
      "tipo_discord": 0,
      "referencia": null,
