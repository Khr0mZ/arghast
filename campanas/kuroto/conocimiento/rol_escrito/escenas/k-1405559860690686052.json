    },
    {
      "mensaje_id": "1405599651033383052",
      "afirmacion": "Ambos deciden regresar a la Base.",
      "tipo": "accion"
    }
  ],
  "notas": [
    "Copito es el apelativo que Seraphina dirige a Kurobane; capitana Hopps se dirige a ella.",
    "La ofrenda de Kurobane carece de descripción; no identificarla como arma, joya o regalo concreto."
  ],
