      "adjuntos": []
    },
    {
      "id": "1374374463562321921",
      "fecha_utc": "2025-05-20T13:13:26.756000+00:00",
      "fecha_local": "2025-05-20",
      "editado_utc": "2025-05-20T13:13:41.282000+00:00",
      "texto": "Banzo : **Mira a kalista y baja la cabeza para andar junto a Danifae fuera de la base ** <@214405113677217793> <@753394009153732689>",
      "mensaje_sha256": "b79f52c3f0ee1b0c947632698331b28f3c29653564960d3a6211de652c3f3916",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1374374463562321921",
      "texto_sha256": "3f635273f2887e46540aa9fdbd80de4dfff21e7c7ec41186eecef0a3dd18483e",
      "adjuntos": []
    },
    {
      "id": "1374374565555208282",
      "fecha_utc": "2025-05-20T13:13:51.073000+00:00",
      "fecha_local": "2025-05-20",
      "editado_utc": null,
      "texto": "Kalista: **Te mira desafiante, su sonrisa se borra una vez os vais por la puerta**",
