      "adjuntos": []
    },
    {
      "id": "1438890181360091318",
      "fecha_utc": "2025-11-14T13:55:52.523000+00:00",
      "fecha_local": "2025-11-14",
      "editado_utc": null,
      "texto": "Jelbreg: **Te rodea con los brazos con fuerza** Lo solucionaremos **Aprieta los dientes con rabia sin que la tritón lo vea**",
      "mensaje_sha256": "7b097462c674265ae9b86f829c4563e24cc0ed1224c1fd01369d833e6e685968",
      "tipo_discord": 19,
      "referencia": "1438889398304379021",
