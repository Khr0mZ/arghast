      "adjuntos": []
    },
    {
      "id": "1438894766346469406",
      "fecha_utc": "2025-11-14T14:14:05.669000+00:00",
      "fecha_local": "2025-11-14",
      "editado_utc": null,
      "texto": "Kalista: **Se abraza a ti** Todo parece estar haciendose cuesta arriba... Desde el sur, las esferas, los tritones....",
      "mensaje_sha256": "48f168a936a80fc5efdd87b2f1382af7435a7478c5b802a2079ea2206e42b668",
      "tipo_discord": 19,
