      "fecha_utc": "2025-08-23T20:32:15.358000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "O'Fortune: Bueno... ¿Y que quieres?",
      "mensaje_sha256": "b86710dfd616f18a5a4c371c81e9fe932f099e61f5f8ccff947332d15d66545c",
      "tipo_discord": 19,
