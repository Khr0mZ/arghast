    },
    {
      "id": "1408912628633571349",
      "fecha_utc": "2025-08-23T20:35:46.997000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "Arwen: oye sabes hablar con adultos **Ves que saca un puñado de bayas del pelo, y le ofrece una como quien chismea y come pipas**",
      "mensaje_sha256": "8d245e28bc5a03de57b160d8b50b93c78337a6706ca65c1235b2e4becf55994c",
      "tipo_discord": 19,
      "referencia": "1408911740955000992",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1408912628633571349",
      "texto_sha256": "9319ad91b5bdcbcda42dc68aeaf70aa59d32d9faac60757f15c3d339cf5b1980",
      "adjuntos": []
    },
    {
