      "adjuntos": []
    },
    {
      "id": "1408903925368881193",
      "fecha_utc": "2025-08-23T20:01:11.977000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "O'Fortune: **El laprechaunt te sigue hasta la taberna, no sabe que quieres, peor le has invocado tu, así que te obedecera en lo que pidas.** Que lugar más extraño...esto no es el feywild... O eso creo...",
      "mensaje_sha256": "25d9bc057edad8feb98c36379d1ee9aca601467aab87311b2e3dea74804a6505",
      "tipo_discord": 19,
      "referencia": "1408903472149041284",
