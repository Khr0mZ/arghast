      "texto_sha256": "7b781f702e0d9ee8e41155818c502effc03d76fe9f7e512905b504df045e0c64",
      "adjuntos": []
    },
    {
      "id": "1408909081741365279",
      "fecha_utc": "2025-08-23T20:21:41.352000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": "2025-08-23T20:21:57.438000+00:00",
      "texto": "Ushi: A ver... que la ultima vez casi te vas sin pagar... si no fuera por Jhin **Te mira frunciendo el ceño**\n\nO'Fortune: Si mi costillar puede estar al punto por favor... no me gusta que este muy cruda o muy hecha y....",
      "mensaje_sha256": "2aa5694445ed6cdfe4cb74f3bbbbe85299f5515695e1b3c656f021cc6cfdb945",
      "tipo_discord": 19,
      "referencia": "1408907598144733224",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1408909081741365279",
      "texto_sha256": "57171f32b3b2ed9192c6acaf94d80e107cd3db85ace71d9e582e8176d16266bb",
      "adjuntos": []
    },
    {
      "id": "1408909214272983141",
      "fecha_utc": "2025-08-23T20:22:12.950000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "Arwen: tengo dinero",
      "mensaje_sha256": "676396163fe0f961f18cf8f65c2a0223bd883e701480549a6f86b8c2f8cc63dc",
      "tipo_discord": 19,
      "referencia": "1408909081741365279",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1408909214272983141",
      "texto_sha256": "c9fd9c70b718f100a92634dd199744de12ad5cb60d2b10555a9e98935bb24032",
      "adjuntos": []
    },
    {
      "id": "1408909960284475484",
      "fecha_utc": "2025-08-23T20:25:10.813000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "Ushi: Mmmmmh... te lo traigo... Pero como no pagues esta vez voy a ir personalmente a Palacio para hablar con la Shogun sobre ti. Ya esta bien de que estés siempre corriendo por allí causando caos... **El tabernero se va a preparar la comida**\n\nO'Fortune: Con una copa de vino añejo de las cascadas florales de Viña Aromática por favor **Dice el laprechaunt al tabernero mientras se va. Mira a Arwen** ¿Tu crees que me habrá oído?",
      "mensaje_sha256": "cda886a762d11616cc6548c75a4258ca82a84df23b7cb8e75423d7004b5f9682",
      "tipo_discord": 19,
      "referencia": "1408909214272983141",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1408909960284475484",
      "texto_sha256": "7e744ca1a75ef24b56149d04c3dd219b92f8b05279c0ac312d4c3791458d0841",
      "adjuntos": []
    },
    {
      "id": "1408911362599555074",
      "fecha_utc": "2025-08-23T20:30:45.151000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "Arwen: creo q no",
      "mensaje_sha256": "bae92a1935b3fdc4f18191e12332e5d2ba029ffda3177770f436bb69b241561a",
      "tipo_discord": 19,
      "referencia": "1408909960284475484",
