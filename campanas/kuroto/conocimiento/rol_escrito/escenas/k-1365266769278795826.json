    },
    {
      "id": "1365268177197727804",
      "fecha_utc": "2025-04-25T10:08:18.900000+00:00",
      "fecha_local": "2025-04-25",
      "editado_utc": null,
      "texto": "Kurobane: \n\nSiempre son bueno los rayos del sol, en lugar de la lluvia permanente \n\n**Da un paso lateral para dejarle su espacio personal a Kalista**",
      "mensaje_sha256": "0851e6182fb16652d4b281057338bcf0ffc4ee4e63cd93fc069db2040b314850",
      "tipo_discord": 0,
      "referencia": null,
