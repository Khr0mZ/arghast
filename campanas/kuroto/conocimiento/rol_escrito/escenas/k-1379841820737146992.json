    },
    {
      "id": "1379850911832211526",
      "fecha_utc": "2025-06-04T15:54:53.771000+00:00",
      "fecha_local": "2025-06-04",
      "editado_utc": null,
      "texto": "Kalista: la piedra",
      "mensaje_sha256": "a37d37f9cbdc4c6b70a7ac47b76f526af189ca554d121ed060898b716a3fc9d8",
      "tipo_discord": 19,
      "referencia": "1379850827480432780",
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1379850911832211526",
      "texto_sha256": "59ac257ab642694f0d3ac1728d30d153d049d7c94da1f9a08d583ea7515f3955",
