  "fuentes": [
    {
      "id": "1415341003325444231",
      "fecha_utc": "2025-09-10T14:19:50.957000+00:00",
      "fecha_local": "2025-09-10",
      "editado_utc": null,
      "texto": "Kalista: **Aterriza encima del techo de la base de los cuchillas negras**",
      "mensaje_sha256": "e44f0b8fded31b2b1feaeb3782441f799827b6f271c5fd934ca1fda091574b61",
      "tipo_discord": 0,
