    {
      "id": "1455588659444187166",
      "fecha_utc": "2025-12-30T15:49:39.941000+00:00",
      "fecha_local": "2025-12-30",
      "editado_utc": null,
      "texto": "Vespera: **Parece sorprendida, incluso maravillada** ¿Miau? ¿Miau miau?",
      "mensaje_sha256": "ad2e6459d7e3e225d9f04a9d70f46d0263db9be9da533b44045dba02be814a86",
      "tipo_discord": 19,
