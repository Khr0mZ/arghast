    },
    {
      "id": "1455587289093902366",
      "fecha_utc": "2025-12-30T15:44:13.224000+00:00",
      "fecha_local": "2025-12-30",
      "editado_utc": null,
      "texto": "Chanecuxtli:\nHuy pío, se parece a cuando el hombre grosero y gruñón se enojaba, pío \n\n**Mire la nota con curiosidad**\n\nQué dice pío?, que dice pío?, una sorpresa?, pío?",
      "mensaje_sha256": "1d7ec5dd2c37ca0c7e302df76ff823cd4894a0d18ec0ca9dd0aaf87ec5750c7d",
      "tipo_discord": 19,
      "referencia": "1455586253432033453",
