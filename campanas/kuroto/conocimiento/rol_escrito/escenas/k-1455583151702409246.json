      "adjuntos": []
    },
    {
      "id": "1455587574092529906",
      "fecha_utc": "2025-12-30T15:45:21.173000+00:00",
      "fecha_local": "2025-12-30",
      "editado_utc": null,
      "texto": "Vespera: **Gira sobre si misma sin darle la espalda** Miau miua miua... Miau miau miau",
      "mensaje_sha256": "90d4dec349b60b9ba3e4cfa08d6fc5d360d010648fd5a446914f4cdbb1679864",
