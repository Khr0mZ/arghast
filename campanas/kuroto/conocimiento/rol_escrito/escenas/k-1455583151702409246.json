      "texto_sha256": "4b4bca356eee41fa55c27366f2e72c7e9249672c683826582ebd9ee378d22944",
      "adjuntos": []
    },
    {
      "id": "1455592632272289935",
      "fecha_utc": "2025-12-30T16:05:27.137000+00:00",
      "fecha_local": "2025-12-30",
      "editado_utc": null,
      "texto": "<@616683133374562304>",
      "mensaje_sha256": "35c51a2b941d828513bceb24575d38d688a517f7c3bee3df1a4a3b3097237f60",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362072544009523360/1455592632272289935",
      "texto_sha256": "3308bf4e0062fe070e1d9fb755e340dcc6c9d991669c162aed939e118811dd7c",
