      "texto_sha256": "3d2512aade1e3724df229f7fadb073a43337de548f434a4336a6801929c3e2d4",
      "adjuntos": []
    },
    {
      "id": "1384219628993118218",
      "fecha_utc": "2025-06-16T17:14:37.109000+00:00",
      "fecha_local": "2025-06-16",
      "editado_utc": null,
      "texto": "Kazuki:\n\n**mira a todos lados, se da cuenta que nadie le está viendo, mientras entra por otro de los callejones se va volviendo invisible y después de otro momento, en mitad del tiempo la invisibilidad, se transforma en Dante, se queda en una esquina esperando**",
      "mensaje_sha256": "3c26b51f76e2ed62b1c124dd8a3ed2775c227c3a5b244c88983864d71b6d99b9",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1379945696089604209/1384219628993118218",
      "texto_sha256": "5c0f19bdf6a0a7c685baad967b188fcc642d08e7eb90e831cbe996b996ab8f73",
      "adjuntos": []
    },
    {
      "id": "1384220407107813436",
      "fecha_utc": "2025-06-16T17:17:42.626000+00:00",
      "fecha_local": "2025-06-16",
      "editado_utc": "2025-06-16T17:17:59.643000+00:00",
      "texto": "Seraphina:\nCreo que no entendiste~\n\n**Pasé una mano desde su pecho hasta su mentón**\n\nMe refiero a que será interesante conocerle mejor, señor John~, ahora hay que dar con ese amiguito",
      "mensaje_sha256": "82d366e9743b1ce815e948dd1569c0e65676ec4c3d6596425fe5ab1cc2a51ecc",
      "tipo_discord": 19,
      "referencia": "1384218986044068073",
      "url_discord": "https://discord.com/channels/946724148628041748/1379945696089604209/1384220407107813436",
      "texto_sha256": "671170b39d308d6d0fb160dd78d483b06ed868f837fb1c0052cb926f9cd6ba20",
      "adjuntos": []
    },
    {
      "id": "1384220738076151858",
      "fecha_utc": "2025-06-16T17:19:01.535000+00:00",
      "fecha_local": "2025-06-16",
      "editado_utc": "2025-06-16T17:19:15.085000+00:00",
      "texto": "John: señorita no me gusta juntar el placer y los negocios además nos están observando , Nuestro invitado ha llegado ya",
      "mensaje_sha256": "1c161143963406d40996f9b1dbba988244cef8926b90b01609200084d6044e74",
      "tipo_discord": 19,
      "referencia": "1384220407107813436",
