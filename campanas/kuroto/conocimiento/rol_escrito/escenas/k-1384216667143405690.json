      "texto_sha256": "e7c54fd8357bc78bbad6c010d3ff154ff4bf5b66cc15152529fdccf6c56800ff",
      "adjuntos": []
    },
    {
      "id": "1384221120701403198",
      "fecha_utc": "2025-06-16T17:20:32.760000+00:00",
      "fecha_local": "2025-06-16",
      "editado_utc": null,
      "texto": "**Veríais a un ser que coincide con la descripción que os ha dado Kazuki en el fondo apoyado en una pared**",
      "mensaje_sha256": "cfad48b86c8c39e80d8d4390ccd2f39dc910d50bfdc10537d360fe5d3d7931b2",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1379945696089604209/1384221120701403198",
      "texto_sha256": "9da8297ba311f864ff33ee62b92c0d1bc6ef771ac1627ac1f73f4fd7b9702a09",
