    {
      "id": "1363227046784008345",
      "fecha_utc": "2025-04-19T18:57:35.487000+00:00",
      "fecha_local": "2025-04-19",
      "editado_utc": null,
      "texto": "Banzo: **Mira a kuro , se sorprende ** \nO debes de ser uno de los nuevos de la manada , encantado yo soy Banzo , y ellos son Errk y Shiretsu",
      "mensaje_sha256": "d4b813710bbfe979b6845c3fe1b3a10a25753080ef54a90194421e300ef7f06d",
      "tipo_discord": 19,
      "referencia": "1363225764467839339",
