      "texto_sha256": "05105352b7aee0b40d1277ae311f6635d70cd0c2dd554027999b79c6487aae14",
      "adjuntos": []
    },
    {
      "id": "1453794736610476175",
      "fecha_utc": "2025-12-25T17:01:15.408000+00:00",
      "fecha_local": "2025-12-25",
      "editado_utc": null,
      "texto": "Kazuki:\n\nSoy todo oidos, Guxi\n\n**Dice sonriente mientras se coloca a su lado**",
      "mensaje_sha256": "69fa9626c9474c85313804d4b4a1bf52118d2c307160435e6328c091efd15e25",
      "tipo_discord": 19,
      "referencia": "1453794014846386196",
