      "texto_sha256": "9f599941cf2ee577d428e6bc97a04971db22aab1d974811b18720add2c5ca915",
      "adjuntos": []
    },
    {
      "id": "1453795301214392462",
      "fecha_utc": "2025-12-25T17:03:30.020000+00:00",
      "fecha_local": "2025-12-25",
      "editado_utc": null,
      "texto": "guxi:\nEstoy pensando seriamente en aceptar el trato de thiary.\nPero se que es una vibora me gustaria saber tu opinion",
      "mensaje_sha256": "fc62ba0770bb0335795fe46a56bec627283006e82b775eff4f17e6728d68aa02",
      "tipo_discord": 19,
      "referencia": "1453794736610476175",
