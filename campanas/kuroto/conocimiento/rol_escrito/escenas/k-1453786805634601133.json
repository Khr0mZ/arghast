    },
    {
      "id": "1453793712323690770",
      "fecha_utc": "2025-12-25T16:57:11.199000+00:00",
      "fecha_local": "2025-12-25",
      "editado_utc": null,
      "texto": "Kazuki:\n\nTe pido perdón por llegar tarde, estuve ayudando a Banzo con unas cosas",
