      "adjuntos": []
    },
    {
      "id": "1453794014846386196",
      "fecha_utc": "2025-12-25T16:58:23.326000+00:00",
      "fecha_local": "2025-12-25",
      "editado_utc": null,
      "texto": "guxi:\nSupongo que te has preguntado por que estamos fuera y no dentro\n**su cara era seria pero habia decision en su mirada**",
      "mensaje_sha256": "01b125ecf206ab95a04bae353a9feb3d1530979873a706cd21b95e0b9076637a",
      "tipo_discord": 19,
      "referencia": "1453793712323690770",
