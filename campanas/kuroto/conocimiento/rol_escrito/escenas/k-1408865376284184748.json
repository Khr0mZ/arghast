      "texto_sha256": "e870fc004c4ec976794050fc63bc44242112b460ed61276431a16c74a393bccc",
      "adjuntos": []
    },
    {
      "id": "1408876974222344274",
      "fecha_utc": "2025-08-23T18:14:06.323000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "Kashai: ¿Eh? **Ladea la cabeza confuso** Que niña mas rara... Entonces... ¿Lo vendes para conseguir monedas de oro?",
      "mensaje_sha256": "35ca8df55aa866d0a79509f3e63b8a1482f522545473339b3395d2d2345939ca",
