      "adjuntos": []
    },
    {
      "id": "1408878674341527585",
      "fecha_utc": "2025-08-23T18:20:51.663000+00:00",
      "fecha_local": "2025-08-23",
      "editado_utc": null,
      "texto": "Kashai: Facil....? Bueno... mira... Si me traes mas cosas de estas yo te las cambio por dinero, te parece bien? **Dice observando algunos de los ingredientes mas extraños** Te haré un trato justo.",
      "mensaje_sha256": "4e9cd4ab98ba743e76b9a117d4b25c4595c5eea5aadb8300b8a18a2a7a52f901",
      "tipo_discord": 19,
