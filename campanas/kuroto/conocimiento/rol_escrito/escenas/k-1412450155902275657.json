      "fecha_local": "2025-09-02",
      "editado_utc": null,
      "texto": "Xyllya: Pero la muerte es normal... todos tenemos que morir algún día, sino seria todo muy aburrido y lleno de gente...",
      "mensaje_sha256": "1b960d2158a2039452f1e6513fb10eb8ef2405dd13cb0aa63d3fba0019c8770f",
      "tipo_discord": 19,
      "referencia": "1412457267122667703",
