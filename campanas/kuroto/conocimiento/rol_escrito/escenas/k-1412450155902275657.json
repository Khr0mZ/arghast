    },
    {
      "id": "1412453146504204349",
      "fecha_utc": "2025-09-02T15:04:32.237000+00:00",
      "fecha_local": "2025-09-02",
      "editado_utc": null,
      "texto": "Xyllya: Eso eso, que me costó mucho hacer tantos bigotes... Digo... El que los hizo... **Ves que va detrás tuyo mientras extiendes la sal, sin saber que hacer** ¿Para que es el ritual?",
      "mensaje_sha256": "87dff474578c481ba765fe6289d996bd1af92fcbfa2b69141e39c95e0e39d54b",
      "tipo_discord": 19,
      "referencia": "1412452677312450560",
