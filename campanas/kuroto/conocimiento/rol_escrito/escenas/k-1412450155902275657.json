      "tipo_discord": 19,
      "referencia": "1412450562112356485",
      "url_discord": "https://discord.com/channels/946724148628041748/1362071806441160834/1412450815909560485",
      "texto_sha256": "9e41456b692b90b8fd765ce503804a29e5c0c7eba12f2066f5aa2391d319a24c",
      "adjuntos": []
    },
