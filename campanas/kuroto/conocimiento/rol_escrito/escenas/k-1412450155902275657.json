      "tipo_discord": 19,
      "referencia": "1412453146504204349",
      "url_discord": "https://discord.com/channels/946724148628041748/1362071806441160834/1412453540575580322",
      "texto_sha256": "54e74fc1cd59f2fa90667549435d69246363d69fd4d72bb1666a739dd96e2273",
      "adjuntos": []
    },
    {
      "id": "1412454015626903583",
      "fecha_utc": "2025-09-02T15:07:59.452000+00:00",
      "fecha_local": "2025-09-02",
      "editado_utc": null,
      "texto": "Xyllya: Aaaaaaah... ¿Y por que? **Sigue detrás tuyo intentando no pisar la sal**",
      "mensaje_sha256": "edea1d0ff94248198810d6a09f807bb881fe9f4ed7eb75c729bb5f0a5ca35907",
