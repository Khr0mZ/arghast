    },
    {
      "id": "1412453540575580322",
      "fecha_utc": "2025-09-02T15:06:06.191000+00:00",
      "fecha_local": "2025-09-02",
      "editado_utc": null,
      "texto": "Arwen: crear barrera para que mas cosas malas no se extiendan por el bosque",
