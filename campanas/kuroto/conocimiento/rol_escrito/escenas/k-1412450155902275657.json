    },
    {
      "id": "1412457267122667703",
      "fecha_utc": "2025-09-02T15:20:54.669000+00:00",
      "fecha_local": "2025-09-02",
      "editado_utc": null,
      "texto": "Arwen: mmmmhhh porque no quiero que muera el bosque... Tengo que cumplir con lo que dijo mi mama",
