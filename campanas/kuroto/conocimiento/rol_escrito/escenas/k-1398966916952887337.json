      "adjuntos": []
    },
    {
      "id": "1398992475879772282",
      "fecha_utc": "2025-07-27T11:36:38.273000+00:00",
      "fecha_local": "2025-07-27",
      "editado_utc": "2025-07-27T11:37:05.986000+00:00",
      "texto": "Jelbreg: **Levanta una ceja interesado en lo que acaba de decir el gnomo. Parece estar interesado** ¿Podría hacer eso?",
