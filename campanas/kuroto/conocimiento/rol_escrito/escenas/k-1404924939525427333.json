      "texto_sha256": "cb8ca29ddfaa0b86a8766cc006e1099a67ff1b44244cfe8cdcddfaa0ae6f9242",
      "adjuntos": []
    },
    {
      "id": "1404925880513597520",
      "fecha_utc": "2025-08-12T20:33:52.175000+00:00",
      "fecha_local": "2025-08-12",
      "editado_utc": null,
      "texto": "Seraphina:\n\nDeja de endulzarme las orejas, que no te creo nada\n\n**Cerré un momento los ojos al sentir su beso en mi mejilla**\n\nQue eso deberías guardarlo para una luna con más dulzór, como la miel",
      "mensaje_sha256": "97e0b7c8563dd919aa0e1d8f80b6a9dbfd66638fc28da78d62292e934f79976a",
      "tipo_discord": 19,
