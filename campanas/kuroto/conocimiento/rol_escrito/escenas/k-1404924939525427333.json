    },
    {
      "id": "1404925696698220757",
      "fecha_utc": "2025-08-12T20:33:08.350000+00:00",
      "fecha_local": "2025-08-12",
      "editado_utc": null,
      "texto": "guxi:\nsoñé con algo muy bonito y cuando me desperté el sueño se volvió realidad , Todavia no me lo creo pero al verte con ese anillo soy muy feliz\n** le da un beso en la mejilla**",
      "mensaje_sha256": "d5c7ab66f44cee08d55dfba7ef37df40965fce9a1bc12a42d70aabe6f49fa756",
      "tipo_discord": 19,
      "referencia": "1404925529089376369",
