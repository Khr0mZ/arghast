      "fecha_utc": "2025-05-18T20:26:55.476000+00:00",
      "fecha_local": "2025-05-18",
      "editado_utc": null,
      "texto": "guxi: gracias cuento contigo tengo contacto directo con kurobane si lo ves a el puedes hablar conmigo yo igualmente estare aqui hasta que esto termine **se despide con un gesto**",
      "mensaje_sha256": "3278a0e4053ea78b6e7f1b1a039434e1bcc83ba517b8fa712c83297ce8b836f7",
      "tipo_discord": 19,
      "referencia": "1373758261857222768",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1373758776309584004",
