      "texto_sha256": "3f92e0ca42b2ef774287b4664c7e7cf3e18317c680542e2e911048bef4e07eb2",
      "adjuntos": []
    },
    {
      "id": "1373753829262360637",
      "fecha_utc": "2025-05-18T20:07:16.008000+00:00",
      "fecha_local": "2025-05-18",
      "editado_utc": null,
      "texto": "Guxi: gracias kalista **intenta dedicarte una sonrisa pero se le apaga muy rapido** necesitaras esto mientras tanto  **te ofrece una llave**",
      "mensaje_sha256": "cc3856e89d19b6c93d03239961fe4bdbcef6fa9a6f6e3852de43f846f2340394",
      "tipo_discord": 19,
      "referencia": "1373753382719717416",
