    {
      "id": "1373753382719717416",
      "fecha_utc": "2025-05-18T20:05:29.544000+00:00",
      "fecha_local": "2025-05-18",
      "editado_utc": null,
      "texto": "Kalista: ....**Te mira unos segundos** Creo que si lo contases al resto de cazadores de unirian a ti...**Te sonrie suave** Yo misma ire contigo para asegurarme de que ninguna tormenta pueda hacer naufragar tu barco",
      "mensaje_sha256": "979f191622a41c3f09ac061e503276c0f0531f21bcf772b5b3ca4d945a8f26bf",
      "tipo_discord": 19,
