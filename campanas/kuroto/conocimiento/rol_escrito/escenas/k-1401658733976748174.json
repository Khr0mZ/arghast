      "texto_sha256": "784937659a4abb9e2347a70d0eea44a4a1c35af756852a63a7846bcc0ea5ab5c",
      "adjuntos": []
    },
    {
      "id": "1402284818221240365",
      "fecha_utc": "2025-08-05T13:39:13.856000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Shizzuka: Si, a veces se les escucha por la noche. Pero yo creo que les gano a los dos... Aunque no me dejan jugar nunca...",
      "mensaje_sha256": "6d32fdce5d82a9e7ea855899e23dbd5b0858cf3b107e9166918de3a63316d9a8",
      "tipo_discord": 19,
      "referencia": "1402284580056072243",
      "url_discord": "https://discord.com/channels/946724148628041748/1387915737502580886/1402284818221240365",
      "texto_sha256": "3b3f20ebe8b18bc1231d2ceea0f05e0fdfc21d73eed1e5388d73d668e21e3472",
      "adjuntos": []
    },
    {
      "id": "1402284851612356739",
      "fecha_utc": "2025-08-05T13:39:21.817000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Arwen: pues si el elfo hace muchas cosquillas a la pez y ella es muy ruidosa",
      "mensaje_sha256": "01e7f3d757c4559505ef22ad69845679cfa24e77d01b8696bf4b49fcacf79655",
      "tipo_discord": 19,
      "referencia": "1402284580056072243",
