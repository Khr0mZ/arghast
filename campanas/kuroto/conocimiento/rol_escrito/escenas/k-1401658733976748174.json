      "adjuntos": []
    },
    {
      "id": "1402284580056072243",
      "fecha_utc": "2025-08-05T13:38:17.073000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Banzo : **rie a carcajadas ** \nMadre mia pequeña ves con ojo que a estos dos les gusta mucho hacer guerras de cosquillas entre ellos",
      "mensaje_sha256": "8efe772024ae8379c4a309664aa11125e57cce05661c6f48c3af3d52ffebff91",
      "tipo_discord": 19,
      "referencia": "1402284008162988122",
