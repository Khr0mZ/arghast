      "adjuntos": []
    },
    {
      "id": "1401935806850924615",
      "fecha_utc": "2025-08-04T14:32:23.061000+00:00",
      "fecha_local": "2025-08-04",
      "editado_utc": null,
      "texto": "Shizzuka: Lo pagarás caro monstruo! **Salta hacia Banzo y empieza a hacerle cosquillas allá donde pilla** Je je je",
