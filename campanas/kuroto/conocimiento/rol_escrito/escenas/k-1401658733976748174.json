      "texto_sha256": "d6d59c2031c6d580e0fcd20409a38d69f353e235a1a181ce62bb19b0cb67dab5",
      "adjuntos": []
    },
    {
      "id": "1402247290969915533",
      "fecha_utc": "2025-08-05T11:10:06.662000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Shizzuka: Ja ja ja toma toma **Grita la niña mientras le hace cosquillas por la espalda y tiene a Arwen babeando encima de su cabeza. Se mueve escalando por el cuerpo del goliat hasta que se agarra al brazo de este, y se resbala por el hacia abajo. Cuando hace eso, no encuentra resistencia de la mano y cae de culo al suelo** Auch! Pensaba que me agarrarías, Banzo!",
      "mensaje_sha256": "d833e27b1bbe2c36f2e08cde2e846a2a64fb77e9c639fa722050fb82ccd1b32c",
      "tipo_discord": 19,
      "referencia": "1402245720043425812",
      "url_discord": "https://discord.com/channels/946724148628041748/1387915737502580886/1402247290969915533",
      "texto_sha256": "8e0b600e60a75f8b7ed398dd6b9903ec73cbf7f64e733992a0a6c343830128b3",
      "adjuntos": []
    },
    {
      "id": "1402257610073182422",
      "fecha_utc": "2025-08-05T11:51:06.928000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Arwen; mmmmhhhhhhhhhhh **Dice con la boca encajada en tu cabeza**",
