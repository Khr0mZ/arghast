      "adjuntos": []
    },
    {
      "id": "1402270151008845986",
      "fecha_utc": "2025-08-05T12:40:56.920000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Shizzuka: Arg, que asco Arwen. No lamas el pelo de otros. Pueden tener bichos y pegartelos, has de tener cuidado **Se acerca a Banzo y le extiende la manita moviendo los deditos** Vamos Banzo, que te enseño que he aprendido nuevo, ya verás je je je <@616683133374562304>",
      "mensaje_sha256": "53e63751e8db1a9b0b96020d26737d771299eee6559d20935654e0c2824eb423",
      "tipo_discord": 19,
      "referencia": "1402267022498336849",
      "url_discord": "https://discord.com/channels/946724148628041748/1387915737502580886/1402270151008845986",
      "texto_sha256": "2fceb17bc26de139e9bf2118c659a6c20d1c71d9d18ca35e6a5ca95319a2e570",
      "adjuntos": []
    },
    {
      "id": "1402273064011436092",
      "fecha_utc": "2025-08-05T12:52:31.434000+00:00",
      "fecha_local": "2025-08-05",
      "editado_utc": null,
      "texto": "Banzo : **rie a carcajadas por la proposición de Arwen de solo imaginarse com 4 pelos en la cabeza ** \nEhh! Que yo me labo la calva esta limpia **extiende despreocupado el brazo para darle la mano a Shizzuka y salir a que le enseñe el nuevo truco **",
      "mensaje_sha256": "c9b8d5a40aed2dcbb6a2e40e45b16d300d35f176130c6961fed720840f4b7ca2",
      "tipo_discord": 19,
