      "texto_sha256": "497901282749c06afabc7afa279904647b368f9c6227b6e1ee0a2e0c17c4fa88",
      "adjuntos": []
    },
    {
      "id": "1371859879190335498",
      "fecha_utc": "2025-05-13T14:41:23.123000+00:00",
      "fecha_local": "2025-05-13",
      "editado_utc": null,
      "texto": "???: Vaya...¿Que casualidad encontrarte por aqui? **Ves una sombra parandose detras tuya**",
      "mensaje_sha256": "7a926faf09edb76e344cb6250433b51da7a2c8ea03017cb6eb8e1e984c7dbdb9",
      "tipo_discord": 19,
      "referencia": "1371857080562221057",
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1371859879190335498",
