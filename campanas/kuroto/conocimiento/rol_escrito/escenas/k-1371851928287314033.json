  "fuentes": [
    {
      "id": "1371851928287314033",
      "fecha_utc": "2025-05-13T14:09:47.480000+00:00",
      "fecha_local": "2025-05-13",
      "editado_utc": null,
      "texto": "**Arwen te guia por las calles, dais bastantes rodeos e incluso Arwen se pierde. Continuais asi por un largo rato hasta introduciros en los barrios bajos...Una vez alli la mezcla de tantos olores nauseabundos y extraños confunde mucho a la pobre criatura que empieza a mirar hacia las calles con un lloriqueo frustrado**",
      "mensaje_sha256": "f0e1088e827579be9569452982e3f2a95abefe2697c1be904094fc83ca60d2a0",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1371851928287314033",
      "texto_sha256": "69c721c0c194c90309c8acb30ac18fccb32194fb457e5f742d6fe3987fa62d63",
      "adjuntos": []
    },
    {
      "id": "1371851950332579892",
      "fecha_utc": "2025-05-13T14:09:52.736000+00:00",
