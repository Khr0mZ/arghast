      "mensaje_sha256": "ba8d62b4e790d0b5ec6b2988e476ae19bddd971bb38850a4ec2a65c90b4f4a51",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1362858862608384070/1371851950332579892",
      "texto_sha256": "ac93d358c181353378177a6cb49577e35ef8406127fe712a70490ca6135fb57d",
