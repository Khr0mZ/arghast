    },
    {
      "id": "1382011376549105738",
      "fecha_utc": "2025-06-10T14:59:48.699000+00:00",
      "fecha_local": "2025-06-10",
      "editado_utc": null,
      "texto": "Stug: ¿Y quien deiablos eres tu? **Te dice el hombre malhumorado**",
      "mensaje_sha256": "ae97d5043e6e269fa1573e4fb540377a50c7c98d5a8edc6bafdc6e437ac6adba",
      "tipo_discord": 19,
