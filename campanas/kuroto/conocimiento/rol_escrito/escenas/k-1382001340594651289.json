    },
    {
      "id": "1382028178255515688",
      "fecha_utc": "2025-06-10T16:06:34.538000+00:00",
      "fecha_local": "2025-06-10",
      "editado_utc": null,
      "texto": "Archi: leopold la balanza.  No me haga perder el tiempo",
      "mensaje_sha256": "db627621e50710bf779663d2652ea32e0e2c8ced711624d77396edd5fabbc263",
      "tipo_discord": 0,
      "referencia": null,
      "url_discord": "https://discord.com/channels/946724148628041748/1379945696089604209/1382028178255515688",
      "texto_sha256": "40e6cd8cbb348543f0652a66d27833e9807802435fe46b1af5d3ab3d1a66e3cb",
