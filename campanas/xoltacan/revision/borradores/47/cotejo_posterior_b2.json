  "hallazgos": [
    {
      "id": "47-POST-B2-01",
      "tipo": "declaracion_personaje",
      "afirmacion": "Tessa habla con Eldrath de Oliver como alguien amable, educado, reservado e introvertido. El contexto inmediato de la pregunta lo identifica como su hermano, ya presentado así en el 47.",
      "evidencias": [
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537964736753303582",
          "cita": "Oye...¿Tu hermano no es tan desienteresado como tu no?",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537964736753303582",
          "fecha_utc": "2026-08-14T23:22:47.245000+00:00",
          "texto_sha256": "461268ff726539a3e900a9cc8ab004be3a9e2813850e911ec39d115efc982ea2"
        },
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537966074593808536",
          "cita": "Oliver... Uuhhh... Es un caballero... Amable... Educado... Ahh... Es bastante más reservado que yo... Un poco... Introvertido... Pero es la persona más buena que conozco",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537966074593808536",
          "fecha_utc": "2026-08-14T23:28:06.211000+00:00",
          "texto_sha256": "4801ac83e0f5b4b4b631013285c3c4ef82c17a10817b2e4bbb7758d507d04da9"
        }
      ],
      "aportacion": "Permite ampliar la historia y el vínculo de Oliver mediante la opinión posterior de su hermana.",
      "limites": "No localiza a Oliver, no acredita su seguridad presente ni explica cómo obtuvo su nombre el dragón. La valoración moral pertenece a Tessa."
    },
    {
      "id": "47-POST-B2-02",
      "tipo": "hecho_narrado_en_rol_posterior",
      "afirmacion": "Walulu intenta administrar antitoxinas a Tessa; la humana se marea y vomita tanto la poción como las hierbas que había recibido. Eldrath también se encuentra dolorido y el texto atribuye ese dolor al veneno.",
      "evidencias": [
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537970129806172160",
          "cita": "empieza a vomitarlas junto a la mezcla de hierbas que l e había dado Walulu antes.",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537970129806172160",
          "fecha_utc": "2026-08-14T23:44:13.049000+00:00",
          "texto_sha256": "69cefce1b410330e511db7f9d1204f35c8bb09e77adc52a375a7415a83a47d79"
        },
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537974123072856094",
          "cita": "Se levanta encorbandose de dolor, porque el veneno le afecta tambien.",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537974123072856094",
          "fecha_utc": "2026-08-15T00:00:05.118000+00:00",
          "texto_sha256": "6328fe5f2316a7623a79a2d5a24f7453d0d55097cc87911be5aa4412abd730ba"
        }
      ],
      "aportacion": "Documenta un tratamiento médico posterior y su fracaso inmediato.",
      "limites": "La escena no reconstruye cómo se envenenaron, no identifica al causante de ese episodio y no aporta una debilidad, ubicación de guarida o estrategia de caza del dragón. No es prueba de que continuara el veneno de los muertos del 47."
    },
    {
      "id": "47-POST-B2-03",
      "tipo": "hecho_narrado_en_rol_posterior",
      "afirmacion": "Tras advertir que puede ser peligroso, Walulu recita un mantra; un círculo aparece a los pies de Tessa y salen raíces que la envuelven. Eldrath se aparta y llega el marcador final de escena antes de un resultado.",
      "evidencias": [
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537974576410005534",
          "cita": "Tendré que probar algo, aunque puede ser algo peligroso",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537974576410005534",
          "fecha_utc": "2026-08-15T00:01:53.202000+00:00",
          "texto_sha256": "3e1d558817b32533e1aabc8372a2db8f68291d70fc0a6e1c038d23eddf4dae16"
        },
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537974576410005534",
          "cita": "un círculo mágico aparece a los pies de Tessa y unas raíces empiezan asalir de el mientras la envuelven",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537974576410005534",
          "fecha_utc": "2026-08-15T00:01:53.202000+00:00",
          "texto_sha256": "3e1d558817b32533e1aabc8372a2db8f68291d70fc0a6e1c038d23eddf4dae16"
        },
        {
          "escena": "x-1537945553915089056",
          "mensaje_id": "1537975960681447464",
          "cita": "Abre los ojos y trastavillea entre las raices alejandose del circulo",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1537975960681447464",
          "fecha_utc": "2026-08-15T00:07:23.238000+00:00",
          "texto_sha256": "748ebc03c28ab1a97aaa73f4a25b046b6d652468b25c650073556310bca122a8"
        }
      ],
      "aportacion": "Amplía el repertorio observado de curación intentada por Walulu y la atención posterior a Tessa.",
      "limites": "No se confirma curación ni daño del ritual. Sus raíces no se identifican con las que animaban cadáveres o inmovilizaban al grupo en el 47. No se conecta este procedimiento con la investigación de libros antiguos prometida entonces."
    },
    {
      "id": "47-POST-B2-04",
      "tipo": "experiencia_subjetiva_narrada",
      "afirmacion": "En el recuerdo deformado del teatro, las imágenes del padre y Oliver hablan con la voz del dragón. Tessa no logra soltarse de la mano paterna y la voz le impone como único fin sobrevivir a ella.",
      "evidencias": [
        {
          "escena": "x-1544040982084067438",
          "mensaje_id": "1544040982084067438",
          "cita": "La voz del dragón salió por duplicado de sus dos familiares. Tessa intentó soltarle la mano. No pudo",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1544040982084067438",
          "fecha_utc": "2026-08-31T17:47:37.023000+00:00",
          "texto_sha256": "e3c7bee26858738e08ef8e08cc832ab5f2555e0ec64398c9dc34091110bd0597"
        },
        {
          "escena": "x-1544040982084067438",
          "mensaje_id": "1544040982084067438",
          "cita": "Sobrevivir a mí...",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1544040982084067438",
          "fecha_utc": "2026-08-31T17:47:37.023000+00:00",
          "texto_sha256": "e3c7bee26858738e08ef8e08cc832ab5f2555e0ec64398c9dc34091110bd0597"
        }
      ],
      "aportacion": "Da una manifestación posterior concreta del temor al dragón que invade la representación subjetiva de su familia. Puede añadirse al seguimiento de la amenaza personal contra Oliver como contexto psicológico posterior.",
      "limites": "No acredita posesión real del padre o Oliver, ni captura, daño o desplazamiento presente. La voz del dragón forma parte de la experiencia narrada; no se verifica una intervención externa actual o el mecanismo de acceso a la memoria. Tampoco prueba que siga vigente el mismo encantamiento de llevar a los elfos."
    },
    {
      "id": "47-POST-B2-05",
      "tipo": "experiencia_subjetiva_narrada",
      "afirmacion": "En otro recuerdo transformado, Tessa descubre que ha lanzado contra la imagen de su madre y ve a Oliver herido detrás de ella. Una voz ya inhumana, situada en el bosque de esa visión, le exige elegir a quién salvar.",
      "evidencias": [
        {
          "escena": "x-1546437630781296680",
          "mensaje_id": "1546437630781296680",
          "cita": "Era un recuerdo perfecto, o eso creía.",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1546437630781296680",
          "fecha_utc": "2026-09-07T08:31:02.600000+00:00",
          "texto_sha256": "3ab6a866fec8e92bac0c008a04f8ed3a77ce3d3fdb6654b09924e384cba0feed"
        },
        {
          "escena": "x-1546437630781296680",
          "mensaje_id": "1546437630781296680",
          "cita": "La voz comenzó a cambiar, hasta dejar de parecer humana.",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1546437630781296680",
          "fecha_utc": "2026-09-07T08:31:02.600000+00:00",
          "texto_sha256": "3ab6a866fec8e92bac0c008a04f8ed3a77ce3d3fdb6654b09924e384cba0feed"
        },
        {
          "escena": "x-1546437630781296680",
          "mensaje_id": "1546437630781296680",
          "cita": "Ahora elige a quién quieres salvar.",
          "url_discord": "https://discord.com/channels/946724148628041748/1504602363728756846/1546437630781296680",
          "fecha_utc": "2026-09-07T08:31:02.600000+00:00",
          "texto_sha256": "3ab6a866fec8e92bac0c008a04f8ed3a77ce3d3fdb6654b09924e384cba0feed"
        }
      ],
      "aportacion": "Amplía el motivo posterior de la familia convertida en objeto de una elección amenazadora.",
      "limites": "No representa heridas reales de Oliver o de la madre ni una elección ejecutada. El mensaje no nombra al dragón: conectarlo causalmente con Clolgedranx sería una inferencia sin demostración. No hay respuesta de Tessa ni despertar narrado."
    }
  ],
  "preguntas_que_si_avanzan": [
    {
