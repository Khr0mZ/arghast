      "texto_sha256": "04327e92c2b42999287d6019a6e4090eed6fb72b056df2f36dd7d6f83fd75a1f",
      "adjuntos": []
    },
    {
      "id": "1528738073813455023",
      "fecha_utc": "2026-07-20T12:19:19.377000+00:00",
      "fecha_local": "2026-07-20",
      "editado_utc": null,
      "texto": "Parroter: Eso no saber, no no no. **Dijo moviendo la cabeza de lado a lado** Dar antídoto y esperar.",
