    },
    {
      "id": "1489592991692881980",
      "fecha_utc": "2026-04-03T11:50:44.519000+00:00",
      "fecha_local": "2026-04-03",
      "editado_utc": null,
      "texto": "Tryel: ELDRAAAAAAATH!!! **Ves a tu hermana que te saluda efusivamente. No parece importarle que todo el mundo la mire**",
      "mensaje_sha256": "27872abe4ddaee99f6f05ffce2d936e66b4c419a7452ef16462213152f8baff7",
      "tipo_discord": 19,
      "referencia": "1489580183265476690",
