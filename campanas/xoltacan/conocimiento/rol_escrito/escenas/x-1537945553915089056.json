    },
    {
      "mensaje_id": "1537970129806172160",
      "afirmacion": "Tessa vomita las antitoxinas y la mezcla de hierbas.",
      "tipo": "accion"
    },
    {
      "mensaje_id": "1537974576410005534",
      "afirmacion": "Walulu inicia un ritual y unas raíces envuelven a Tessa.",
      "tipo": "accion"
    }
  ],
  "notas": [
    "Cierre formal sin desenlace del ritual; mantener vinculación con las curas precedentes.",
    "La mezcla y el círculo no se convierten en una cura comprobada por el solo hecho de iniciarse."
