      "texto_sha256": "c856eb132ffe7c78476bf9c2c359d40e925637779a98f4a30eb69d2b9e27d136",
      "adjuntos": []
    },
    {
      "id": "1483449444379787305",
      "fecha_utc": "2026-03-17T12:58:28.698000+00:00",
      "fecha_local": "2026-03-17",
      "editado_utc": null,
      "texto": "Mamá Citlali:\nYa un poco mejor, tuve que coserme las heridas y el huevo sigue bien, así que puedo darme un tiempo para respirar",
      "mensaje_sha256": "1c5bc9beb89a57906df9f9cb5ea13488bba0b4cbe9281a162bcb6acfb963361b",
      "tipo_discord": 19,
      "referencia": "1483448274181554257",
