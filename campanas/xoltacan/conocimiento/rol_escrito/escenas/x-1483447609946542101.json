      "fecha_utc": "2026-03-17T12:59:50.396000+00:00",
      "fecha_local": "2026-03-17",
      "editado_utc": null,
      "texto": "patata:\nQuiza donde voy a ir sepan algo sobre su afliccion señorita",
      "mensaje_sha256": "31745fd6a19439afdd19881607a912f7de8dc1188757334dd55fe537f1a4e3e2",
      "tipo_discord": 19,
      "referencia": "1483449444379787305",
