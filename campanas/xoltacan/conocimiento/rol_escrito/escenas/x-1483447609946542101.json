    },
    {
      "id": "1483447928696869050",
      "fecha_utc": "2026-03-17T12:52:27.331000+00:00",
      "fecha_local": "2026-03-17",
      "editado_utc": null,
      "texto": "Mamá Citlali:\n**Había bajado del barco para estirar las piernas un ratito hasta que ví a la distancia a la Patata**\n\nBuen día mijo, te ves distinto... Algo bueno te paso, qué es?",
      "mensaje_sha256": "b5479437095d99e4d4e993c4818de7f535cee9d28dd72ff29a3e48836cf89763",
      "tipo_discord": 19,
      "referencia": "1483447609946542101",
      "url_discord": "https://discord.com/channels/946724148628041748/1465410265544921190/1483447928696869050",
      "texto_sha256": "2a6d4e77269a570d95b07b2ab716b7412e6ffabbf55944ce6b14b6534e234312",
      "adjuntos": []
    },
    {
      "id": "1483448274181554257",
      "fecha_utc": "2026-03-17T12:53:49.701000+00:00",
      "fecha_local": "2026-03-17",
      "editado_utc": null,
      "texto": "patata:\nestoy llevando algunos negocios nada importante y preparandome para un viaje por la jungla\n¿como le va a usted?",
      "mensaje_sha256": "a7bce6beaea2a6dc778e557daa5265996a0ee54adc06bea174923dd34d5dee88",
      "tipo_discord": 19,
      "referencia": "1483447928696869050",
