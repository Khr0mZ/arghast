      "texto_sha256": "aedfaf1adb59f1862b9bf5884b41ad5c6ebe62b2e31bef0083dacf59f87374a2",
      "adjuntos": []
    },
    {
      "id": "1483451216272031854",
      "fecha_utc": "2026-03-17T13:05:31.150000+00:00",
      "fecha_local": "2026-03-17",
      "editado_utc": null,
      "texto": "Mamá Citlali:\nYa tan pronto tiene un lugar a dónde ir?, menos mal, eso de estar metidos en este pueblo es horrible, al fin podremos respirar aire puro",
