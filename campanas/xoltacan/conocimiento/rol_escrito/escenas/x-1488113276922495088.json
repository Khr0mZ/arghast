      "fecha_utc": "2026-03-30T10:02:06.421000+00:00",
      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "patata:\n*curioso lugar parece que una bestia viviera aqui mas que una persona*\nMe dio esto me dijo que te la diera si tardaba mucho en volver\n**saca de su abrigo una carta y se la ofrece**",
      "mensaje_sha256": "32728149fe8cc3125a5f86ec822403a476fd56d80658edb0054dd2df2ceeebaa",
      "tipo_discord": 19,
      "referencia": "1488115765025443972",
