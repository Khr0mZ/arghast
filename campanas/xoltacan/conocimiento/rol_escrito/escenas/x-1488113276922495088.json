      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "Ione: si y necesitamos a alguien astuto, que sepa meterse en esa clase de lugares",
      "mensaje_sha256": "e582de4fc174fafaf4532d7299104a2f00da8956d3ea1d2bd8c96ed03b6d672c",
