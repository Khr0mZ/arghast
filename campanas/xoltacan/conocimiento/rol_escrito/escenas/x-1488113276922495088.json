    },
    {
      "id": "1488163118444974202",
      "fecha_utc": "2026-03-30T13:08:56.171000+00:00",
      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "Patata:\nDéjame las palabras a mí jovencita pero no podemos colarnos en una base tan grande fácilmente.\nNo tendréis por aquí alguien que antes fuera de la marina?",
      "mensaje_sha256": "576dacd337b3670e1ab23051785e705469ecd4bab4ac3048cd945d446df62472",
      "tipo_discord": 19,
      "referencia": "1488162737866674337",
