    },
    {
      "id": "1488115765025443972",
      "fecha_utc": "2026-03-30T10:00:46.236000+00:00",
      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "Ione: **Entra al interior del barco rauda y va a su camarote, se pone a un lado de la puerta para que pases. Cuando lo haces cierra detras. Su cuarto esta lleno de arañazos y marcas en la madera** Dime q te dio Nox",
      "mensaje_sha256": "1c11ee3b2685d38d4a324f16a59933085b0c8749627809a9f4dbb99c67a2ca93",
      "tipo_discord": 19,
      "referencia": "1488115327525978267",
      "url_discord": "https://discord.com/channels/946724148628041748/1465411590789795962/1488115765025443972",
      "texto_sha256": "20ae1a6f578c1967f866d74066042bda3b1ca31f1039a0df425e98805997acbf",
      "adjuntos": []
    },
    {
