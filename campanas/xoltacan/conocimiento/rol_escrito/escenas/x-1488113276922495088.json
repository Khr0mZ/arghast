      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "Ione: que cuando lo traiga aqui lo voy a colgar de los gallumbos del palo mayor por calzonazos",
      "mensaje_sha256": "9286cd8cf83be374dae7a804af0bb845aaa541ef8b0ce4f858414df5cc081f30",
