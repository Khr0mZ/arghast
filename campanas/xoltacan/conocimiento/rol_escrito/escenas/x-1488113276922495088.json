      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "patata:\nadelante las damas primero \n**le hace una señal para que le guie**",
      "mensaje_sha256": "39bce7c6067fbcb62a6a573e42ad73c435af665ca92308a3565da23f10d605c8",
      "tipo_discord": 19,
      "referencia": "1488114757536976987",
