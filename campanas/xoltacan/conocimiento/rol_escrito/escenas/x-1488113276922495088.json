      "texto_sha256": "c5c3b06313e195978509aeffd050155429e4b336e6e8be18dbd111e5da251120",
      "adjuntos": []
    },
    {
      "id": "1488116235056189512",
      "fecha_utc": "2026-03-30T10:02:38.300000+00:00",
      "fecha_local": "2026-03-30",
      "editado_utc": null,
      "texto": "Ione: **Toma la carta y la lee**",
      "mensaje_sha256": "025c64b580b2299c15b2dff7ea64fc297c3bc5d4621bbb0f5d26f4b9f17768bc",
      "tipo_discord": 19,
