    {
      "id": "1484221147649146972",
      "fecha_utc": "2026-03-19T16:04:57.095000+00:00",
      "fecha_local": "2026-03-19",
      "editado_utc": null,
      "texto": "Tryel: **Recibe el golpe en el estómago y escupe sangre. Levanta la vista y mira a Ione con la boca llena de sangre** ¡Je je je, esto será divertido! **Agarra una silla medio rota que hay y se la estampa a Ione en el costado**",
      "mensaje_sha256": "c4c9b0745a87486dbaa247b2f96e896a802c91bd4522f907a2a7aabdb8820a3e",
      "tipo_discord": 19,
      "referencia": "1484220546349662229",
