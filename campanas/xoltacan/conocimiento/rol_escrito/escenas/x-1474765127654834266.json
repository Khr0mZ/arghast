      "fecha_utc": "2026-02-23T17:23:36.566000+00:00",
      "fecha_local": "2026-02-23",
      "editado_utc": null,
      "texto": "Ione: **Se escucha otro bonk** AY **Se pone en pie y camina** Cof cof DE DONDE SALE NIEBLA A ESTAS HORAS",
