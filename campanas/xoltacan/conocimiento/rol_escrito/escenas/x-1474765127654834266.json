      "adjuntos": []
    },
    {
      "id": "1476241117690204183",
      "fecha_utc": "2026-02-25T15:35:09.691000+00:00",
      "fecha_local": "2026-02-25",
      "editado_utc": null,
      "texto": "Nox : ** despues de intentar reunir la que aunque escasa, mayor cantidad de piezas de plata del Zampaolas, cubiertos , candelabros , alguna que otra moneda , se dirige a su camarote para buscar a Citlali <@408026114548695061> **",
      "mensaje_sha256": "db7a5bfd6fcd13026b1663088540872c71ae59c39829745912d0c3b3c9cd64b4",
      "tipo_discord": 0,
      "referencia": null,
