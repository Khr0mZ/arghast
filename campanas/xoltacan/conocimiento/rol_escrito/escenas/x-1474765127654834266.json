      "adjuntos": []
    },
    {
      "id": "1475560743142424669",
      "fecha_utc": "2026-02-23T18:31:35.758000+00:00",
      "fecha_local": "2026-02-23",
      "editado_utc": null,
      "texto": "Ione: **Se ve a Ione escaleras abajo con un cubo en la cabeza, una barba de algas secas apestosas y dos estrellas de mar pegados a su top. Toda cabeza abajo**",
      "mensaje_sha256": "919c2f3d533a0c9ba7700e196bfec031c36ea32a7ac2194b6700cd39d8a9c4d9",
