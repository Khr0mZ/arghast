      "id": "1476253760165515275",
      "fecha_utc": "2026-02-25T16:25:23.892000+00:00",
      "fecha_local": "2026-02-25",
      "editado_utc": null,
      "texto": "Luna: \nYo te ayudo!!\n** Luna la ayuda a incorporarse mientras aprovecha de dejar a buen recaudo algún objeto que cae en sus manos **",
      "mensaje_sha256": "e5881d909cd8f6ea95d0ba1d21de19f90b88a0daa397638efbacf8bf0e5ed5f5",
