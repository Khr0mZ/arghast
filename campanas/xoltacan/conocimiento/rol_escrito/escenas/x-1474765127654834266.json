    {
      "id": "1474798412619841546",
      "fecha_utc": "2026-02-21T16:02:21.998000+00:00",
      "fecha_local": "2026-02-21",
      "editado_utc": null,
      "texto": "Luna: \n      ** al escuchar ruidos abajo Luna se acerca sigilosamente... ** \n       mmm no es la chica que cantaba ** sonrie levemente **\n      ** mientras hace sus ejercicios empieza a sonar una musica acorde al ritmo de los golpes **\n      puede que con eso se anime a cantar nuevamente",
      "mensaje_sha256": "9ceba8cf3092c034cda4eade20dcd241247bffb79650ae2451bf646436951a5c",
      "tipo_discord": 19,
      "referencia": "1474765127654834266",
